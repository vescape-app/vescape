EXPO_PUBLIC_GOOGLE_MAPS_API_KEY=
EXPO_PUBLIC_MAPBOX_ACCESS_TOKEN=
EXPO_PUBLIC_MAPY_API_KEY=
EXPO_PUBLIC_CLERK_PUBLISHABLE_KEY=

# Local app identity. Unset in CI/release builds → production (`app.vescape`).
EXPO_PUBLIC_VESCAPE_APP_VARIANT=development


# Sentry crash reporting. DSN unset → Sentry disabled (fine for local dev).
EXPO_PUBLIC_SENTRY_DSN=
# Build-time only, for source-map/native-symbol upload:
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# Vescape backend (../vescape-server) — one server behind every networked feature.
# Unset → prod (https://api.vescape.app). For a local server (`bun dev` in
# ../vescape-server) point here — `bun run android` then tunnels the device's
# localhost:3000 to your machine. Re-run `bun run relay:reverse` after a device
# or adb restart without a rebuild.
# EXPO_PUBLIC_SERVER_URL=http://localhost:3000


# Apple Developer team ID (10 chars). Needed to sign iOS device builds — without it prebuild
# writes an Xcode project with no DEVELOPMENT_TEAM and the build fails at the signing step.
# Simulator builds do not need it. CI supplies it as a secret.
# APPLE_TEAM_ID=
