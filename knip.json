{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["maestro", "adb", "awk", "swift", "fmt"],
  "ignoreDependencies": ["sharp", "@sentry/cli", "@phosphor-icons/core"],
  "ignore": [
    "scripts/**/*",
    ".agents/**/*",
    ".claude/**/*",
    "app.config.ts",
    "targets/**/*",
    "watch/watchos/**/*"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": ["plugins/**/*", "e2e/flows/**/*.js"]
    },
    "modules/*": {}
  }
}
