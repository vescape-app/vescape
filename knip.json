{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "tags": ["-lintignore"],
  "ignoreBinaries": ["maestro", "adb", "awk", "swift", "fmt"],
  "ignoreDependencies": ["sharp", "@sentry/cli", "@phosphor-icons/core"],
  "ignore": [
    "scripts/**/*",
    ".agents/**/*",
    ".claude/**/*",
    "app.config.ts",
    "targets/**/*",
    "watch/watchos/**/*"
  ],
  "ignoreExportsUsedInFile": true,
  "workspaces": {
    ".": {
      "entry": [
        "plugins/**/*",
        "e2e/flows/**/*.js",
        "src/modules/group-ride/components/RiderMapLayers.tsx",
        "src/modules/history/components/PrivacyZonesMapLayer.tsx",
        "src/modules/legal/components/LegalLimitsMapLayer.tsx",
        "src/modules/weather/components/RadarRangeRings.tsx",
        "src/modules/weather/components/RainViewerOverlay.tsx",
        "src/screens/main/map/NavigationMapLayers.tsx"
      ]
    },
    "modules/*": {}
  }
}
