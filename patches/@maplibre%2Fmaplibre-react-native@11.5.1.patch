+// Spike #655 instrumentation: hop latency (TurboModule call -> main-thread block) and write cost,
+// logged every 120 writes.
+static void MLRNRecordDirectWrite(NSString *callThread, CFTimeInterval calledAt,
+                                  CFTimeInterval startedAt, CFTimeInterval endedAt) {
+  static int count = 0;
+  static double hopSum = 0, hopMax = 0, writeSum = 0, writeMax = 0;
+  double hop = (startedAt - calledAt) * 1e6;
+  double write = (endedAt - startedAt) * 1e6;
+  count++;
+  hopSum += hop;
+  hopMax = MAX(hopMax, hop);
+  writeSum += write;
+  writeMax = MAX(writeMax, write);
+  if (count < 120) return;
+  NSLog(@"MLRNDirect setCameraDirect n=%d call=%@ write=%@ hop avg=%.0fus max=%.0fus write "
+        @"avg=%.0fus max=%.0fus",
+        count, callThread, [NSThread isMainThread] ? @"main" : @"other", hopSum / count, hopMax,
+        writeSum / count, writeMax);
+  count = 0;
+  hopSum = hopMax = writeSum = writeMax = 0;
+}
+
+static NSString *MLRNCurrentQueueLabel(void) {
+  if ([NSThread isMainThread]) return @"main";
+  const char *label = dispatch_queue_get_label(DISPATCH_CURRENT_QUEUE_LABEL);
+  return label ? [NSString stringWithUTF8String:label] : @"?";
+}
+
+// Spike #655: void, no promise per frame. The TurboModule call lands on this module's method
+// queue; withCamera hops to the main thread (addUIBlock), where the write runs synchronously.
+// @parity /node_modules/@maplibre/maplibre-react-native/android/src/main/java/org/maplibre/reactnative/components/camera/MLRNCameraModule.kt `setCameraDirect`
+- (void)setCameraDirect:(NSInteger)reactTag
+              centerLng:(double)centerLng
+              centerLat:(double)centerLat
+                   zoom:(double)zoom
+                  pitch:(double)pitch
+                bearing:(double)bearing
+             paddingTop:(double)paddingTop
+           paddingRight:(double)paddingRight
+          paddingBottom:(double)paddingBottom
+            paddingLeft:(double)paddingLeft {
+  CFTimeInterval calledAt = CACurrentMediaTime();
+  NSString *callThread = MLRNCurrentQueueLabel();
+  [self withCamera:reactTag
+             block:^(MLRNCamera *view) {
+               CFTimeInterval startedAt = CACurrentMediaTime();
+               [view setCameraDirect:centerLng
+                           centerLat:centerLat
+                                zoom:zoom
+                               pitch:pitch
+                             bearing:bearing
+                          paddingTop:paddingTop
+                        paddingRight:paddingRight
+                       paddingBottom:paddingBottom
+                         paddingLeft:paddingLeft];
+               MLRNRecordDirectWrite(callThread, calledAt, startedAt, CACurrentMediaTime());
+             }
+            reject:^(NSString *code, NSString *message, NSError *error) {
+              NSLog(@"setCameraDirect: %@ %@", code, message);
+            }
+        methodName:@"setCameraDirect"];
+}
+
+// Puck spike: same queue and main-thread hop as setCameraDirect, so a puck write and a camera write
+// sent in one JS tick reach the map in order, before its next frame.
+// @parity /node_modules/@maplibre/maplibre-react-native/android/src/main/java/org/maplibre/reactnative/components/camera/MLRNCameraModule.kt `setPuckDirect`
+- (void)setPuckDirect:(NSInteger)reactTag
+                  lng:(double)lng
+                  lat:(double)lat
+              bearing:(double)bearing
+                color:(NSInteger)color
+          shadowAlpha:(double)shadowAlpha
+              visible:(BOOL)visible {
+  // TODO(ios parity): the iOS layer still draws the flat disc; shadowAlpha is not used yet.
+  [self withCamera:reactTag
+             block:^(MLRNCamera *view) {
+               [view setPuckDirect:lng lat:lat bearing:bearing argb:(uint32_t)color visible:visible];
+             }
+            reject:^(NSString *code, NSString *message, NSError *error) {
+              NSLog(@"setPuckDirect: %@ %@", code, message);
+            }
+        methodName:@"setPuckDirect"];
+}
+
+- (void)cancelCameraAnimations:(NSInteger)reactTag {
