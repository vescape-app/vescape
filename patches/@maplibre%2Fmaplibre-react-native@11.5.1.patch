+    // Spike #655: void, no promise per frame. The TurboModule call lands on the native modules
+    // thread; withViewResolved hops to the UI thread, where the write runs synchronously.
+    override fun setCameraDirect(
+        reactTag: ReactTag,
+        centerLng: Double, centerLat: Double, zoom: Double, pitch: Double, bearing: Double,
+        paddingTop: Double, paddingRight: Double, paddingBottom: Double, paddingLeft: Double,
+    ) {
+        val calledAt = SystemClock.elapsedRealtimeNanos()
+        val callThread = Thread.currentThread().name
+        reactTagResolver.withViewResolved<MLRNCamera>(reactTag.toInt(), null) {
+            val startedAt = SystemClock.elapsedRealtimeNanos()
+            it.setCameraDirect(centerLng, centerLat, zoom, pitch, bearing, paddingTop, paddingRight, paddingBottom, paddingLeft)
+            DirectWriteStats.record(callThread, calledAt, startedAt, SystemClock.elapsedRealtimeNanos())
+        }
+    }
+
+    override fun cancelCameraAnimations(reactTag: ReactTag) {
+        reactTagResolver.withViewResolved<MLRNCamera>(reactTag.toInt(), null) {
+            it.cancelCameraAnimations()
+        }
+    }
+
+    /** Spike #655 instrumentation: hop latency and write cost, logged every 120 writes. */
+    private object DirectWriteStats {
+        private var count = 0
+        private var hopSum = 0L
+        private var hopMax = 0L
+        private var writeSum = 0L
+        private var writeMax = 0L
+
+        fun record(callThread: String, calledAt: Long, startedAt: Long, endedAt: Long) {
+            val hop = startedAt - calledAt
+            val write = endedAt - startedAt
+            count++
+            hopSum += hop
+            hopMax = maxOf(hopMax, hop)
+            writeSum += write
+            writeMax = maxOf(writeMax, write)
+            if (count < 120) return
+            Log.i(
+                "MLRNDirect",
+                "setCameraDirect n=$count call=$callThread write=${Thread.currentThread().name} " +
+                    "hop avg=${hopSum / count / 1000}us max=${hopMax / 1000}us " +
+                    "write avg=${writeSum / count / 1000}us max=${writeMax / 1000}us",
+            )
+            count = 0
+            hopSum = 0
+            hopMax = 0
+            writeSum = 0
+            writeMax = 0
+        }
+    }
 }
