+#import <MapLibre/MapLibre.h>
+
+/**
+ Puck spike: the rider puck as a custom style layer, drawn with Metal inside MapLibre's own render
+ pass. Position and bearing are read at draw time, so the puck can never trail the map.
+ */
+@interface MLRNPuckLayer : MLNCustomStyleLayer
+
+/** Places the puck. NaN bearing hides the arrow. Main thread only. */
+- (void)setLng:(double)lng lat:(double)lat bearing:(double)bearing argb:(uint32_t)argb;
