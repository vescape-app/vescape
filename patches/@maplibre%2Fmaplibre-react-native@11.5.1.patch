+package org.maplibre.android.maps;
+
+import androidx.annotation.NonNull;
+import androidx.annotation.Nullable;
+import androidx.annotation.UiThread;
+
+import org.maplibre.android.geometry.LatLng;
+
+import java.lang.reflect.Field;
+
+/**
+ * Spike #655: camera write without MapLibreMap.moveCamera. That path runs
+ * Transform.moveCamera, which calls the Java cancelTransitions() (fling and
+ * easeTo callbacks cancelled, move-canceled/idle dispatched), fires
+ * onCameraMoveStarted and onCameraIdle per write, and posts the callback.
+ * This writes straight into NativeMap.jumpTo, then refreshes the Transform's
+ * cached CameraPosition, which dispatches a single onCameraMove.
+ *
+ * Gesture ValueAnimators (pinch-zoom and rotate deceleration) keep running:
+ * nothing here touches MapGestureDetector. A core transition (pan fling,
+ * Transform.moveBy with duration) is still replaced: mbgl Transform::jumpTo
+ * goes through startTransition, which finishes any running transition.
+ *
+ * Lives in the SDK package for the package-private Transform and NativeMap.
+ */
+public final class MLRNDirectCamera {
+  private static Field nativeMapField;
+
+  private final MapLibreMap map;
+  private final Transform transform;
+  private final NativeMap nativeMap;
+
+  public MLRNDirectCamera(@NonNull MapLibreMap map) {
+    this.map = map;
+    this.transform = map.getTransform();
+    try {
+      if (nativeMapField == null) {
+        Field field = MapLibreMap.class.getDeclaredField("nativeMapView");
+        field.setAccessible(true);
+        nativeMapField = field;
+      }
+      this.nativeMap = (NativeMap) nativeMapField.get(map);
+    } catch (ReflectiveOperationException e) {
+      throw new IllegalStateException("MapLibreMap.nativeMapView not reachable", e);
+    }
+  }
+
+  public boolean isFor(@NonNull MapLibreMap other) {
+    return map == other;
+  }
+
+  /**
+   * NaN keeps a field. Padding in pixels, CameraPosition order: left, top,
+   * right, bottom; null keeps the current padding.
+   */
+  @UiThread
+  public void write(double lng, double lat, double zoom, double pitch, double bearing,
+                    @Nullable double[] paddingPx) {
+    LatLng center = Double.isNaN(lng) || Double.isNaN(lat)
+      ? nativeMap.getLatLng()
+      : new LatLng(lat, lng);
+    // -1 is the native "keep" sentinel for zoom, pitch and bearing.
+    double nativeBearing = Double.isNaN(bearing) ? -1 : ((bearing % 360) + 360) % 360;
+    nativeMap.jumpTo(center, Double.isNaN(zoom) ? -1 : zoom, Double.isNaN(pitch) ? -1 : pitch,
+      nativeBearing, paddingPx);
+    transform.invalidateCameraPosition();
+  }
+}
