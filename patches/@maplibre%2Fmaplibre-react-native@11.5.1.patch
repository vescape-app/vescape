+package org.maplibre.reactnative.components.camera
+
+import android.util.Log
+import org.maplibre.android.maps.MapLibreMap
+import org.maplibre.android.style.layers.CustomLayer
+
+/**
+ * Puck spike: the rider puck as a MapLibre CustomLayer whose C++ host (src/main/cpp) draws with GL
+ * inside the map's own render pass, so it moves with the map in the same frame. The puck state
+ * lives in native memory shared by every host this creates, so updates never re-create the layer.
+ * Added on top of the current style on first use and again after a style swap; removed when hidden.
+ * UI thread only.
+ * @parity /node_modules/@maplibre/maplibre-react-native/ios/components/camera/MLRNCamera.m `setPuckDirect`
+ */
+internal class MLRNPuck {
+    private var state = 0L
+    private var shown = false
+
+    fun set(
+        map: MapLibreMap,
+        lng: Double,
+        lat: Double,
+        bearing: Double,
+        argb: Int,
+        shadowAlpha: Float,
+        visible: Boolean,
+    ) {
+        if (!loaded) return
+        shown = visible && !lng.isNaN() && !lat.isNaN()
+        if (shown) {
+            if (state == 0L) state = nativeCreateState()
+            nativeSet(state, lng, lat, bearing, argb, shadowAlpha)
+        }
+        apply(map)
+    }
+
+    /** Puts the layer in the style or takes it out, to match the last call. */
+    fun apply(map: MapLibreMap) {
+        val style = map.style ?: return
+        if (!style.isFullyLoaded) return
+        val existing = style.getLayer(LAYER_ID)
+        if (!shown) {
+            if (existing != null) style.removeLayer(existing)
+            return
+        }
+        if (existing == null) {
+            style.addLayer(CustomLayer(LAYER_ID, nativeCreateHost(state)))
+            Log.i(TAG, "layer added")
+        }
+        map.triggerRepaint()
+    }
+
+    fun release() {
+        if (state != 0L) nativeReleaseState(state)
+        state = 0L
+        shown = false
+    }
+
+    companion object {
+        private const val TAG = "MLRNPuckLayer"
+        private const val LAYER_ID = "mlrn-puck"
+
+        private val loaded: Boolean =
+            try {
+                System.loadLibrary("mlrnpuck")
+                true
+            } catch (e: UnsatisfiedLinkError) {
+                Log.e(TAG, "libmlrnpuck.so not loaded", e)
+                false
+            }
+
+        @JvmStatic external fun nativeCreateState(): Long
+
+        @JvmStatic external fun nativeReleaseState(state: Long)
+
+        @JvmStatic external fun nativeCreateHost(state: Long): Long
+
+        @JvmStatic external fun nativeSet(
+            state: Long,
+            lng: Double,
+            lat: Double,
+            bearing: Double,
+            argb: Int,
+            shadowAlpha: Float,
+        )
+    }
+}
