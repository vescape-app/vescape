diff --git a/ios/components/camera/MLRNPuckLayer.m b/ios/components/camera/MLRNPuckLayer.m
new file mode 100644
index 0000000000000000000000000000000000000000..a403e33c604badff53708cc9080ffad26c7f4c57
--- /dev/null
+++ b/ios/components/camera/MLRNPuckLayer.m
@@ -0,0 +1,203 @@
+#import "MLRNPuckLayer.h"
+
+// @parity /node_modules/@maplibre/maplibre-react-native/android/src/main/cpp/MLRNPuckLayer.cpp
+
+#import <Metal/Metal.h>
+#import <simd/simd.h>
+
+// Puck spike. Units: MapLibre world pixels at the current zoom (512 << zoom across the world),
+// which are screen points on the ground plane, so the puck keeps its on-screen size at any zoom
+// and is foreshortened by pitch like the map.
+static const float kShadowRadius = 13.5f;
+static const float kRingRadius = 11.f;
+static const float kBodyRadius = 8.5f;
+static const float kArrowTip = 21.f;
+static const float kArrowBase = 11.5f;
+static const float kArrowHalfWidth = 7.f;
+static const int kSegments = 32;
+
+typedef struct {
+  simd_float2 position;
+  simd_float4 color;  // premultiplied
+} MLRNPuckVertex;
+
+static NSString *const kShaderSource =
+    @"#include <metal_stdlib>\n"
+     "using namespace metal;\n"
+     "struct V { float2 position; float4 color; };\n"
+     "struct O { float4 position [[position]]; float4 color; };\n"
+     "vertex O puck_vertex(const device V *v [[buffer(0)]], constant float4x4 &mvp [[buffer(1)]],\n"
+     "                     uint i [[vertex_id]]) {\n"
+     "  O o;\n"
+     "  float4 p = mvp * float4(v[i].position, 0.0, 1.0);\n"
+     // Clip depth pinned inside Metal's [0, w]: the puck is an overlay, never depth-tested.
+     "  p.z = 0.0;\n"
+     "  o.position = p;\n"
+     "  o.color = v[i].color;\n"
+     "  return o;\n"
+     "}\n"
+     "fragment float4 puck_fragment(O in [[stage_in]]) { return in.color; }\n";
+
+static simd_float4 MLRNPremultiplied(float r, float g, float b, float a) {
+  return simd_make_float4(r * a, g * a, b * a, a);
+}
+
+static void MLRNAppendDisc(NSMutableData *data, float radius, simd_float2 offset, simd_float4 color) {
+  for (int i = 0; i < kSegments; i++) {
+    float a0 = 2.f * (float)M_PI * i / kSegments;
+    float a1 = 2.f * (float)M_PI * (i + 1) / kSegments;
+    MLRNPuckVertex tri[3] = {
+        {offset, color},
+        {offset + simd_make_float2(cosf(a0), sinf(a0)) * radius, color},
+        {offset + simd_make_float2(cosf(a1), sinf(a1)) * radius, color},
+    };
+    [data appendBytes:tri length:sizeof(tri)];
+  }
+}
+
+@implementation MLRNPuckLayer {
+  double _lng;
+  double _lat;
+  double _bearing;
+  uint32_t _argb;
+  BOOL _placed;
+
+  id<MTLRenderPipelineState> _pipeline;
+  id<MTLDepthStencilState> _depthState;
+  MTLPixelFormat _colorFormat;
+  MTLPixelFormat _depthFormat;
+  MTLPixelFormat _stencilFormat;
+  NSUInteger _sampleCount;
+
+  id<MTLBuffer> _vertices;
+  NSUInteger _vertexCount;
+  BOOL _geometryDirty;
+}
+
+- (void)setLng:(double)lng lat:(double)lat bearing:(double)bearing argb:(uint32_t)argb {
+  BOOL bearingChanged = !(isnan(bearing) && isnan(_bearing)) && bearing != _bearing;
+  if (bearingChanged || argb != _argb || !_placed) _geometryDirty = YES;
+  _lng = lng;
+  _lat = lat;
+  _bearing = bearing;
+  _argb = argb;
+  _placed = YES;
+  [self setNeedsDisplay];
+}
+
+- (BOOL)preparePipelineFor:(id<MTLDevice>)device pass:(MTLRenderPassDescriptor *)pass {
+  MTLPixelFormat color = pass.colorAttachments[0].texture.pixelFormat;
+  MTLPixelFormat depth =
+      pass.depthAttachment.texture ? pass.depthAttachment.texture.pixelFormat : MTLPixelFormatInvalid;
+  MTLPixelFormat stencil = pass.stencilAttachment.texture ? pass.stencilAttachment.texture.pixelFormat
+                                                          : MTLPixelFormatInvalid;
+  NSUInteger samples = MAX(pass.colorAttachments[0].texture.sampleCount, 1);
+  if (_pipeline && color == _colorFormat && depth == _depthFormat && stencil == _stencilFormat &&
+      samples == _sampleCount) {
+    return YES;
+  }
+  NSError *error = nil;
+  id<MTLLibrary> library = [device newLibraryWithSource:kShaderSource options:nil error:&error];
+  if (!library) {
+    NSLog(@"MLRNPuckLayer: shader compile failed %@", error);
+    return NO;
+  }
+  MTLRenderPipelineDescriptor *desc = [MTLRenderPipelineDescriptor new];
+  desc.vertexFunction = [library newFunctionWithName:@"puck_vertex"];
+  desc.fragmentFunction = [library newFunctionWithName:@"puck_fragment"];
+  desc.rasterSampleCount = samples;
+  desc.colorAttachments[0].pixelFormat = color;
+  desc.colorAttachments[0].blendingEnabled = YES;
+  desc.colorAttachments[0].sourceRGBBlendFactor = MTLBlendFactorOne;
+  desc.colorAttachments[0].sourceAlphaBlendFactor = MTLBlendFactorOne;
+  desc.colorAttachments[0].destinationRGBBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+  desc.colorAttachments[0].destinationAlphaBlendFactor = MTLBlendFactorOneMinusSourceAlpha;
+  desc.depthAttachmentPixelFormat = depth;
+  desc.stencilAttachmentPixelFormat = stencil;
+  _pipeline = [device newRenderPipelineStateWithDescriptor:desc error:&error];
+  if (!_pipeline) {
+    NSLog(@"MLRNPuckLayer: pipeline failed %@", error);
+    return NO;
+  }
+  MTLDepthStencilDescriptor *depthDesc = [MTLDepthStencilDescriptor new];
+  depthDesc.depthCompareFunction = MTLCompareFunctionAlways;
+  depthDesc.depthWriteEnabled = NO;
+  _depthState = [device newDepthStencilStateWithDescriptor:depthDesc];
+  _colorFormat = color;
+  _depthFormat = depth;
+  _stencilFormat = stencil;
+  _sampleCount = samples;
+  return YES;
+}
+
+- (void)rebuildGeometry:(id<MTLDevice>)device {
+  float a = ((_argb >> 24) & 0xFF) / 255.f;
+  float r = ((_argb >> 16) & 0xFF) / 255.f;
+  float g = ((_argb >> 8) & 0xFF) / 255.f;
+  float b = (_argb & 0xFF) / 255.f;
+  NSMutableData *data = [NSMutableData data];
+  MLRNAppendDisc(data, kShadowRadius, simd_make_float2(0, 1.5f), MLRNPremultiplied(0, 0, 0, 0.25f));
+  MLRNAppendDisc(data, kRingRadius, simd_make_float2(0, 0), MLRNPremultiplied(1, 1, 1, 1));
+  MLRNAppendDisc(data, kBodyRadius, simd_make_float2(0, 0), MLRNPremultiplied(r, g, b, a));
+  if (!isnan(_bearing)) {
+    // World y points south; rotating "up" by the bearing clockwise gives (sin b, -cos b).
+    float rad = (float)(_bearing * M_PI / 180.0);
+    float c = cosf(rad), s = sinf(rad);
+    simd_float2 local[3] = {{0, -kArrowTip}, {kArrowHalfWidth, -kArrowBase}, {-kArrowHalfWidth, -kArrowBase}};
+    MLRNPuckVertex tri[3];
+    for (int i = 0; i < 3; i++) {
+      simd_float2 p = local[i];
+      tri[i].position = simd_make_float2(p.x * c - p.y * s, p.x * s + p.y * c);
+      tri[i].color = MLRNPremultiplied(1, 1, 1, 1);
+    }
+    [data appendBytes:tri length:sizeof(tri)];
+  }
+  _vertexCount = data.length / sizeof(MLRNPuckVertex);
+  _vertices = [device newBufferWithBytes:data.bytes
+                                  length:data.length
+                                 options:MTLResourceStorageModeShared];
+  _geometryDirty = NO;
+}
+
+- (void)drawInMapView:(MLNMapView *)mapView withContext:(MLNStyleLayerDrawingContext)context {
+  if (!_placed) return;
+  id<MTLRenderCommandEncoder> encoder = self.renderEncoder;
+  MTLRenderPassDescriptor *pass = self.renderPassDesc;
+  if (!encoder || !pass) return;
+  id<MTLDevice> device = encoder.device;
+  if (![self preparePipelineFor:device pass:pass]) return;
+  if (_geometryDirty || !_vertices) [self rebuildGeometry:device];
+
+  // Puck center in world pixels, in doubles: at zoom 20 the world is ~5e8 px wide, past float.
+  double worldSize = 512.0 * pow(2.0, context.zoomLevel);
+  double lat = fmax(fmin(_lat, 85.051128), -85.051128) * M_PI / 180.0;
+  double x = (_lng + 180.0) / 360.0 * worldSize;
+  double y = (1.0 - log(tan(lat) + 1.0 / cos(lat)) / M_PI) / 2.0 * worldSize;
+
+  // mvp = projection * translate(x, y): only the fourth column changes. MLNMatrix4 is mbgl's
+  // column-major mat4, so m0x is column 0.
+  MLNMatrix4 P = context.projectionMatrix;
+  double col[4][4] = {
+      {P.m00, P.m01, P.m02, P.m03},
+      {P.m10, P.m11, P.m12, P.m13},
+      {P.m20, P.m21, P.m22, P.m23},
+      {P.m30, P.m31, P.m32, P.m33},
+  };
+  simd_float4x4 mvp;
+  for (int c = 0; c < 3; c++) {
+    mvp.columns[c] = simd_make_float4((float)col[c][0], (float)col[c][1], (float)col[c][2],
+                                      (float)col[c][3]);
+  }
+  double t[4];
+  for (int r = 0; r < 4; r++) t[r] = col[0][r] * x + col[1][r] * y + col[3][r];
+  mvp.columns[3] = simd_make_float4((float)t[0], (float)t[1], (float)t[2], (float)t[3]);
+
+  [encoder setRenderPipelineState:_pipeline];
+  [encoder setDepthStencilState:_depthState];
+  [encoder setCullMode:MTLCullModeNone];
+  [encoder setVertexBuffer:_vertices offset:0 atIndex:0];
+  [encoder setVertexBytes:&mvp length:sizeof(mvp) atIndex:1];
+  [encoder drawPrimitives:MTLPrimitiveTypeTriangle vertexStart:0 vertexCount:_vertexCount];
+}
+
