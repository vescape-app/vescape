@@ -0,0 +1,10 @@
+cmake_minimum_required(VERSION 3.22.1)
+project(mlrnpuck CXX)
+
+# Puck spike: CustomLayer host for the rider puck. Does not link libmaplibre.so; MapLibre only
+# calls this through the CustomLayerHost vtable, so the vendored header must match its version.
+add_library(mlrnpuck SHARED MLRNPuckLayer.cpp)
+target_compile_features(mlrnpuck PRIVATE cxx_std_17)
+target_compile_options(mlrnpuck PRIVATE -Wall -Werror=return-type -fvisibility=hidden)
+target_link_options(mlrnpuck PRIVATE -Wl,-z,max-page-size=16384)
+target_link_libraries(mlrnpuck GLESv3 log)
diff --git a/android/src/main/cpp/MLRNPuckLayer.cpp b/android/src/main/cpp/MLRNPuckLayer.cpp
new file mode 100644
index 0000000000000000000000000000000000000000..469e13ef55918dd9b3f96ebdc1951579ed53fba2
--- /dev/null
+++ b/android/src/main/cpp/MLRNPuckLayer.cpp
@@ -0,0 +1,398 @@
+// Puck spike: the rider puck as a MapLibre CustomLayer host, drawn with GLES 3 inside MapLibre's
+// own render pass, so it moves with the map in the same frame.
+// @parity /node_modules/@maplibre/maplibre-react-native/ios/components/camera/MLRNPuckLayer.m
+// TODO(ios parity): iOS still draws the flat disc and ignores shadowAlpha.
+//
+// The coin of GpsPuck (src/modules/map/components/GpsPuck.tsx) as real geometry: ground shadow,
+// shaded base and side wall, top face with a white rim, heading arrow in the top face's plane.
+// Units: x/y in MapLibre world pixels at the current zoom (512 << zoom across the world), which
+// are dp on the ground plane, so the coin keeps its on-screen size at any zoom. The projection
+// matrix takes z in metres (fill-extrusion heights), so the vertex shader turns the coin's pixel
+// heights into metres with the metres-per-pixel the matrix itself was built with.
+// No depth test: the coin is an overlay, drawn back to front (painter's order below).
+
+#include <GLES3/gl3.h>
+#include <android/log.h>
+#include <jni.h>
+
+#include <cmath>
+#include <memory>
+#include <mutex>
+#include <vector>
+
+#include "mln_custom_layer_host.h"
+
+#define LOG_TAG "MLRNPuckLayer"
+#define LOGE(...) __android_log_print(ANDROID_LOG_ERROR, LOG_TAG, __VA_ARGS__)
+#define LOGI(...) __android_log_print(ANDROID_LOG_INFO, LOG_TAG, __VA_ARGS__)
+
+namespace {
+
+// GpsPuck's sizes, in dp.
+constexpr float kCoinRadius = 11.f;      // COIN_SIZE / 2
+constexpr float kCoinHeight = 12.f;      // COIN_HEIGHT
+constexpr float kRimWidth = 3.f;         // coinTop borderWidth
+constexpr float kShadowRadius = 15.f;  // COIN_SHADOW_SIZE / 2
+constexpr double kShadowDrop = 2.0;      // COIN_SHADOW_DROP, towards the bottom of the screen
+constexpr float kWallShade = 0.6f;       // wallShade: 40% black over the rider colour
+constexpr float kArrowHalfWidth = 9.f;   // ARROW_WIDTH / 2
+constexpr float kArrowLength = 14.f;   // ARROW_LENGTH
+constexpr float kArrowTuck = 4.f;        // ARROW_TUCK
+constexpr float kArrowBase = kCoinRadius - kArrowTuck;
+constexpr float kArrowTip = kArrowBase + kArrowLength;
+constexpr int kSegments = 48;
+constexpr double kPi = 3.14159265358979323846;
+constexpr double kEarthRadius = 6378137.0;  // mbgl::util::EARTH_RADIUS_M
+
+// Buffer layout, in draw order.
+constexpr GLint kShadowFirst = 0;
+constexpr GLsizei kDiscCount = 3 * kSegments;
+constexpr GLint kBodyFirst = kShadowFirst + kDiscCount;          // base disc + side wall
+constexpr GLsizei kBodyCount = kDiscCount + 6 * kSegments;
+constexpr GLint kArrowFirst = kBodyFirst + kBodyCount;
+constexpr GLsizei kArrowCount = 3;
+constexpr GLint kTopFirst = kArrowFirst + kArrowCount;           // white rim disc + colour disc
+constexpr GLsizei kTopCount = 2 * kDiscCount;
+constexpr GLsizei kVertexCount = kTopFirst + kTopCount;
+
+/** Written on the UI thread by setPuckDirect, read on the render thread at draw time. */
+struct PuckState {
+  std::mutex mutex;
+  double lng = 0;
+  double lat = 0;
+  double bearing = NAN;
+  uint32_t argb = 0;
+  float shadowAlpha = 0;
+  bool placed = false;
+  /** Bumped when the vertex data (colour or shadow) changes. Bearing is a draw-time rotation. */
+  uint64_t geometryVersion = 1;
+};
+
+struct Snapshot {
+  double lng, lat, bearing;
+  uint32_t argb;
+  float shadowAlpha;
+  bool placed;
+  uint64_t geometryVersion;
+};
+
+struct Vertex {
+  float x, y, z;
+  float r, g, b, a;  // premultiplied
+};
+
+struct Rgba {
+  float r, g, b, a;
+};
+
+const char* kVertexShader =
+    "#version 300 es\n"
+    "uniform mat4 u_mvp;\n"
+    "uniform float u_metersPerPixel;\n"
+    "in vec3 a_pos;\n"
+    "in vec4 a_color;\n"
+    "out vec4 v_color;\n"
+    "void main() {\n"
+    "  vec4 p = u_mvp * vec4(a_pos.xy, a_pos.z * u_metersPerPixel, 1.0);\n"
+    // Clip depth pinned inside [-w, w]: the puck is an overlay, never depth-tested.
+    "  p.z = 0.0;\n"
+    "  gl_Position = p;\n"
+    "  v_color = a_color;\n"
+    "}\n";
+
+const char* kFragmentShader =
+    "#version 300 es\n"
+    "precision mediump float;\n"
+    "in vec4 v_color;\n"
+    "out vec4 fragColor;\n"
+    "void main() { fragColor = v_color; }\n";
+
+Vertex vertex(float x, float y, float z, Rgba c) {
+  return {x, y, z, c.r * c.a, c.g * c.a, c.b * c.a, c.a};
+}
+
+float ringX(int i, float radius) {
+  return std::cos(2.f * static_cast<float>(kPi) * i / kSegments) * radius;
+}
+
+float ringY(int i, float radius) {
+  return std::sin(2.f * static_cast<float>(kPi) * i / kSegments) * radius;
+}
+
+void appendDisc(std::vector<Vertex>& out, float radius, float z, Rgba c) {
+  for (int i = 0; i < kSegments; i++) {
+    out.push_back(vertex(0, 0, z, c));
+    out.push_back(vertex(ringX(i, radius), ringY(i, radius), z, c));
+    out.push_back(vertex(ringX(i + 1, radius), ringY(i + 1, radius), z, c));
+  }
+}
+
+void appendWall(std::vector<Vertex>& out, float radius, float height, Rgba c) {
+  for (int i = 0; i < kSegments; i++) {
+    Vertex b0 = vertex(ringX(i, radius), ringY(i, radius), 0, c);
+    Vertex b1 = vertex(ringX(i + 1, radius), ringY(i + 1, radius), 0, c);
+    Vertex t0 = vertex(ringX(i, radius), ringY(i, radius), height, c);
+    Vertex t1 = vertex(ringX(i + 1, radius), ringY(i + 1, radius), height, c);
+    out.insert(out.end(), {b0, b1, t1, b0, t1, t0});
+  }
+}
+
+/**
+ * projection * translate(x, y) * rotateZ(angle), column-major. The translation is done in doubles:
+ * at zoom 20 the world is ~5e8 px wide, past float.
+ */
+void compose(const std::array<double, 16>& P, double x, double y, double angle, float out[16]) {
+  double c = std::cos(angle), s = std::sin(angle);
+  for (int r = 0; r < 4; r++) {
+    out[r] = static_cast<float>(P[r] * c + P[4 + r] * s);
+    out[4 + r] = static_cast<float>(-P[r] * s + P[4 + r] * c);
+    out[8 + r] = static_cast<float>(P[8 + r]);
+    out[12 + r] = static_cast<float>(P[r] * x + P[4 + r] * y + P[12 + r]);
+  }
+}
+
+GLuint compile(GLenum type, const char* source) {
+  GLuint shader = glCreateShader(type);
+  glShaderSource(shader, 1, &source, nullptr);
+  glCompileShader(shader);
+  GLint ok = 0;
+  glGetShaderiv(shader, GL_COMPILE_STATUS, &ok);
+  if (!ok) {
+    char log[512];
+    glGetShaderInfoLog(shader, sizeof(log), nullptr, log);
+    LOGE("shader compile failed: %s", log);
+    glDeleteShader(shader);
+    return 0;
+  }
+  return shader;
+}
+
+class PuckHost final : public mln::style::CustomLayerHost {
+ public:
+  explicit PuckHost(std::shared_ptr<PuckState> state) : state_(std::move(state)) {
+    vertices_.reserve(kVertexCount);
+  }
+
+  void initialize(const mln::style::CustomLayerInitParameters&) override {
+    GLuint vs = compile(GL_VERTEX_SHADER, kVertexShader);
+    GLuint fs = compile(GL_FRAGMENT_SHADER, kFragmentShader);
+    if (!vs || !fs) return;
+    program_ = glCreateProgram();
+    glAttachShader(program_, vs);
+    glAttachShader(program_, fs);
+    glBindAttribLocation(program_, 0, "a_pos");
+    glBindAttribLocation(program_, 1, "a_color");
+    glLinkProgram(program_);
+    glDeleteShader(vs);
+    glDeleteShader(fs);
+    GLint ok = 0;
+    glGetProgramiv(program_, GL_LINK_STATUS, &ok);
+    if (!ok) {
+      LOGE("program link failed");
+      glDeleteProgram(program_);
+      program_ = 0;
+      return;
+    }
+    mvpLocation_ = glGetUniformLocation(program_, "u_mvp");
+    metersPerPixelLocation_ = glGetUniformLocation(program_, "u_metersPerPixel");
+
+    GLint prevVao = 0, prevBuffer = 0;
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuffer);
+    glGenVertexArrays(1, &vao_);
+    glGenBuffers(1, &buffer_);
+    glBindVertexArray(vao_);
+    glBindBuffer(GL_ARRAY_BUFFER, buffer_);
+    glBufferData(GL_ARRAY_BUFFER, static_cast<GLsizeiptr>(kVertexCount * sizeof(Vertex)), nullptr,
+                 GL_DYNAMIC_DRAW);
+    glEnableVertexAttribArray(0);
+    glVertexAttribPointer(0, 3, GL_FLOAT, GL_FALSE, sizeof(Vertex), reinterpret_cast<void*>(0));
+    glEnableVertexAttribArray(1);
+    glVertexAttribPointer(1, 4, GL_FLOAT, GL_FALSE, sizeof(Vertex),
+                          reinterpret_cast<void*>(3 * sizeof(float)));
+    glBindVertexArray(static_cast<GLuint>(prevVao));
+    glBindBuffer(GL_ARRAY_BUFFER, static_cast<GLuint>(prevBuffer));
+    uploadedVersion_ = 0;
+    LOGI("initialized");
+  }
+
+  void render(const mln::style::CustomLayerRenderParameters& params) override {
+    if (!program_) return;
+    Snapshot s;
+    {
+      std::lock_guard<std::mutex> lock(state_->mutex);
+      s = {state_->lng,     state_->lat,    state_->bearing,        state_->argb,
+           state_->shadowAlpha, state_->placed, state_->geometryVersion};
+    }
+    if (!s.placed) return;
+
+    // Save what this draw touches; MapLibre also marks its state cache dirty afterwards.
+    GLint prevProgram = 0, prevVao = 0, prevBuffer = 0;
+    GLint prevBlendSrcRgb = 0, prevBlendDstRgb = 0, prevBlendSrcA = 0, prevBlendDstA = 0;
+    GLboolean prevDepthMask = GL_TRUE;
+    glGetIntegerv(GL_CURRENT_PROGRAM, &prevProgram);
+    glGetIntegerv(GL_VERTEX_ARRAY_BINDING, &prevVao);
+    glGetIntegerv(GL_ARRAY_BUFFER_BINDING, &prevBuffer);
+    glGetIntegerv(GL_BLEND_SRC_RGB, &prevBlendSrcRgb);
+    glGetIntegerv(GL_BLEND_DST_RGB, &prevBlendDstRgb);
+    glGetIntegerv(GL_BLEND_SRC_ALPHA, &prevBlendSrcA);
+    glGetIntegerv(GL_BLEND_DST_ALPHA, &prevBlendDstA);
+    glGetBooleanv(GL_DEPTH_WRITEMASK, &prevDepthMask);
+    GLboolean prevBlend = glIsEnabled(GL_BLEND);
+    GLboolean prevDepth = glIsEnabled(GL_DEPTH_TEST);
+    GLboolean prevStencil = glIsEnabled(GL_STENCIL_TEST);
+    GLboolean prevCull = glIsEnabled(GL_CULL_FACE);
+
+    glBindVertexArray(vao_);
+    glBindBuffer(GL_ARRAY_BUFFER, buffer_);
+    if (uploadedVersion_ != s.geometryVersion) upload(s);
+
+    double worldSize = 512.0 * std::pow(2.0, params.zoom);
+    double lat = std::fmax(std::fmin(s.lat, 85.051128), -85.051128) * kPi / 180.0;
+    double x = (s.lng + 180.0) / 360.0 * worldSize;
+    double y = (1.0 - std::log(std::tan(lat) + 1.0 / std::cos(lat)) / kPi) / 2.0 * worldSize;
+    // TransformState::getProjMatrix scales z by 1 / metres-per-pixel at the camera's latitude.
+    double metersPerPixel =
+        std::cos(params.latitude * kPi / 180.0) * 2.0 * kPi * kEarthRadius / worldSize;
+    // Screen-down on the ground: the map's bearing turns world north to screen up.
+    double mapBearing = params.bearing * kPi / 180.0;
+    double dropX = -std::sin(mapBearing) * kShadowDrop;
+    double dropY = std::cos(mapBearing) * kShadowDrop;
+
+    glUseProgram(program_);
+    glUniform1f(metersPerPixelLocation_, static_cast<float>(metersPerPixel));
+    glDisable(GL_DEPTH_TEST);
+    glDisable(GL_STENCIL_TEST);
+    glDisable(GL_CULL_FACE);
+    glDepthMask(GL_FALSE);
+    glEnable(GL_BLEND);
+    glBlendFunc(GL_ONE, GL_ONE_MINUS_SRC_ALPHA);
+
+    // Painter's order, valid from any heading and pitch: the camera is always above the coin, so
+    // the top face covers everything under it; the wall is one flat shade, so its back and front
+    // halves need no sorting; the arrow lies in the top plane, in front of the wall below it.
+    compose(params.projectionMatrix, x + dropX, y + dropY, 0, mvp_);
+    glUniformMatrix4fv(mvpLocation_, 1, GL_FALSE, mvp_);
+    glDrawArrays(GL_TRIANGLES, kShadowFirst, kDiscCount);
+    compose(params.projectionMatrix, x, y, 0, mvp_);
+    glUniformMatrix4fv(mvpLocation_, 1, GL_FALSE, mvp_);
+    glDrawArrays(GL_TRIANGLES, kBodyFirst, kBodyCount);
+    if (!std::isnan(s.bearing)) {
+      compose(params.projectionMatrix, x, y, s.bearing * kPi / 180.0, mvp_);
+      glUniformMatrix4fv(mvpLocation_, 1, GL_FALSE, mvp_);
+      glDrawArrays(GL_TRIANGLES, kArrowFirst, kArrowCount);
+      compose(params.projectionMatrix, x, y, 0, mvp_);
+      glUniformMatrix4fv(mvpLocation_, 1, GL_FALSE, mvp_);
+    }
+    glDrawArrays(GL_TRIANGLES, kTopFirst, kTopCount);
+
+    GLenum err = glGetError();
+    if (err != GL_NO_ERROR && !loggedError_) {
+      LOGE("GL error 0x%x after draw", err);
+      loggedError_ = true;
+    }
+
+    glUseProgram(static_cast<GLuint>(prevProgram));
+    glBindVertexArray(static_cast<GLuint>(prevVao));
+    glBindBuffer(GL_ARRAY_BUFFER, static_cast<GLuint>(prevBuffer));
+    glBlendFuncSeparate(prevBlendSrcRgb, prevBlendDstRgb, prevBlendSrcA, prevBlendDstA);
+    glDepthMask(prevDepthMask);
+    if (!prevBlend) glDisable(GL_BLEND);
+    if (prevDepth) glEnable(GL_DEPTH_TEST);
+    if (prevStencil) glEnable(GL_STENCIL_TEST);
+    if (prevCull) glEnable(GL_CULL_FACE);
+  }
+
+  void contextLost() override {
+    // The GL objects died with the context; forget the handles, initialize runs again.
+    program_ = 0;
+    vao_ = 0;
+    buffer_ = 0;
+    uploadedVersion_ = 0;
+  }
+
+  void deinitialize() override {
+    if (program_) glDeleteProgram(program_);
+    if (buffer_) glDeleteBuffers(1, &buffer_);
+    if (vao_) glDeleteVertexArrays(1, &vao_);
+    contextLost();
+  }
+
+ private:
+  /** Rebuilds the vertex data into the reserved vector; only when colour or shadow change. */
+  void upload(const Snapshot& s) {
+    Rgba color{((s.argb >> 16) & 0xFF) / 255.f, ((s.argb >> 8) & 0xFF) / 255.f,
+               (s.argb & 0xFF) / 255.f, ((s.argb >> 24) & 0xFF) / 255.f};
+    Rgba shade{color.r * kWallShade, color.g * kWallShade, color.b * kWallShade, color.a};
+    Rgba white{1, 1, 1, 1};
+    vertices_.clear();
+    appendDisc(vertices_, kShadowRadius, 0, {0, 0, 0, s.shadowAlpha});
+    appendDisc(vertices_, kCoinRadius, 0, shade);
+    appendWall(vertices_, kCoinRadius, kCoinHeight, shade);
+    // Pointing north (world y is south); the draw rotates it clockwise by the bearing.
+    vertices_.push_back(vertex(0, -kArrowTip, kCoinHeight, white));
+    vertices_.push_back(vertex(kArrowHalfWidth, -kArrowBase, kCoinHeight, white));
+    vertices_.push_back(vertex(-kArrowHalfWidth, -kArrowBase, kCoinHeight, white));
+    appendDisc(vertices_, kCoinRadius, kCoinHeight, white);
+    appendDisc(vertices_, kCoinRadius - kRimWidth, kCoinHeight, color);
+    glBufferSubData(GL_ARRAY_BUFFER, 0, static_cast<GLsizeiptr>(vertices_.size() * sizeof(Vertex)),
+                    vertices_.data());
+    uploadedVersion_ = s.geometryVersion;
+  }
+
+  std::shared_ptr<PuckState> state_;
+  std::vector<Vertex> vertices_;
+  float mvp_[16] = {};
+  GLuint program_ = 0;
+  GLint mvpLocation_ = -1;
+  GLint metersPerPixelLocation_ = -1;
+  GLuint vao_ = 0;
+  GLuint buffer_ = 0;
+  uint64_t uploadedVersion_ = 0;
+  bool loggedError_ = false;
+};
+
+std::shared_ptr<PuckState>* handle(jlong ptr) {
+  return reinterpret_cast<std::shared_ptr<PuckState>*>(ptr);
+}
+
+}  // namespace
+
+extern "C" {
+
+JNIEXPORT jlong JNICALL
+Java_org_maplibre_reactnative_components_camera_MLRNPuck_nativeCreateState(JNIEnv*, jclass) {
+  return reinterpret_cast<jlong>(new std::shared_ptr<PuckState>(std::make_shared<PuckState>()));
+}
+
+JNIEXPORT void JNICALL
+Java_org_maplibre_reactnative_components_camera_MLRNPuck_nativeReleaseState(JNIEnv*, jclass,
+                                                                            jlong state) {
+  delete handle(state);
+}
+
+/** A new host for one CustomLayer; libmaplibre takes ownership and deletes it with the layer. */
+JNIEXPORT jlong JNICALL
+Java_org_maplibre_reactnative_components_camera_MLRNPuck_nativeCreateHost(JNIEnv*, jclass,
+                                                                          jlong state) {
+  mln::style::CustomLayerHost* host = new PuckHost(*handle(state));
+  return reinterpret_cast<jlong>(host);
+}
+
+JNIEXPORT void JNICALL Java_org_maplibre_reactnative_components_camera_MLRNPuck_nativeSet(
+    JNIEnv*, jclass, jlong state, jdouble lng, jdouble lat, jdouble bearing, jint argb,
+    jfloat shadowAlpha) {
+  PuckState& s = **handle(state);
+  std::lock_guard<std::mutex> lock(s.mutex);
+  if (static_cast<uint32_t>(argb) != s.argb || shadowAlpha != s.shadowAlpha || !s.placed) {
+    s.geometryVersion++;
+  }
+  s.lng = lng;
+  s.lat = lat;
+  s.bearing = bearing;
+  s.argb = static_cast<uint32_t>(argb);
+  s.shadowAlpha = shadowAlpha;
+  s.placed = true;
+}
+
+}  // extern "C"
diff --git a/android/src/main/cpp/mln_custom_layer_host.h b/android/src/main/cpp/mln_custom_layer_host.h
new file mode 100644
index 0000000000000000000000000000000000000000..daa52a00eb6fdd365f038228cf0422ff1693fe11
--- /dev/null
+++ b/android/src/main/cpp/mln_custom_layer_host.h
@@ -0,0 +1,58 @@
+#pragma once
+
+// Puck spike: a copy of the two MapLibre Native declarations a CustomLayer host needs, from
+// maplibre-native tag android-v13.6.1 (c7506d6aff3800e946f89e1a51432fc22d1a6534), the commit
+// libmaplibre.so in org.maplibre.gl:android-sdk-opengl:13.6.1 reports. The AAR ships no headers.
+//   include/mln/style/layers/custom_layer_host.hpp
+//   include/mln/style/layers/custom_layer_init_parameters.hpp
+//   include/mln/style/layers/custom_layer_render_parameters.hpp
+// libmaplibre.so calls these through the vtable and reads the struct by offset, so both must
+// match the shipped binary exactly. Re-check them on any MapLibre Android version change.
+
+#include <array>
+#include <cstddef>
+
+namespace mln {
+
+class PaintParameters;
+
+namespace gfx {
+class Context;
+}  // namespace gfx
+
+namespace style {
+
+struct CustomLayerInitParameters {
+  virtual ~CustomLayerInitParameters() = default;
+};
+
+struct CustomLayerRenderParameters {
+  double width;
+  double height;
+  double latitude;
+  double longitude;
+  double zoom;
+  double bearing;
+  double pitch;
+  double fieldOfView;
+  std::array<double, 16> projectionMatrix;
+  std::array<double, 16> nearClippedProjectionMatrix;
+};
+
+static_assert(offsetof(CustomLayerRenderParameters, projectionMatrix) == 64, "layout");
+static_assert(sizeof(CustomLayerRenderParameters) == 64 + 2 * 128, "layout");
+
+// Vtable order is load-bearing: ~dtor (complete, deleting), initialize, preRender, render,
+// contextLost, deinitialize.
+class CustomLayerHost {
+ public:
+  virtual ~CustomLayerHost() = default;
+  virtual void initialize(const CustomLayerInitParameters&) = 0;
+  virtual void preRender(const gfx::Context&, const CustomLayerRenderParameters&) {}
+  virtual void render(const CustomLayerRenderParameters&) = 0;
+  virtual void contextLost() = 0;
+  virtual void deinitialize() = 0;
+};
+
+}  // namespace style
+}  // namespace mln
diff --git a/android/src/main/java/org/maplibre/android/maps/MLRNDirectCamera.java b/android/src/main/java/org/maplibre/android/maps/MLRNDirectCamera.java
