+            }
+        }
+        if (program != 0) GLES30.glDeleteProgram(program)
+        ids[0] = buffer
+        if (buffer != 0) GLES30.glDeleteBuffers(1, ids, 0)
+        ids[0] = vao
+        if (vao != 0) GLES30.glDeleteVertexArrays(1, ids, 0)
+        contextLost()
+    }
+
+    companion object {
+        private const val TAG = "RNMBXMarkerSprites"
+        /** Doubles per marker in [set]. */
+        private const val STRIDE = 6
+        private const val MAX_LAT = 85.051128
+
+        // The coordinate is projected on the CPU in doubles; the shader snaps it to a whole pixel
+        // and spans the bitmap 1:1 from there, with y flipped from screen-down to GL-up.
+        private const val VERTEX_SHADER = """#version 300 es
+uniform vec4 u_clip;
+uniform vec2 u_viewport;
+uniform vec4 u_rect;
+in vec2 a_corner;
+out vec2 v_uv;
+void main() {
+  vec2 anchor = floor((u_clip.xy / u_clip.w * 0.5 + 0.5) * u_viewport + 0.5);
+  vec2 offset = u_rect.xy + a_corner * u_rect.zw;
+  vec2 pixel = anchor + vec2(offset.x, -offset.y);
+  gl_Position = vec4(pixel / u_viewport * 2.0 - 1.0, 0.0, 1.0);
+  v_uv = a_corner;
+}
+"""
+
+        // The bitmap is premultiplied, as the host's blend function expects.
+        private const val FRAGMENT_SHADER = """#version 300 es
+precision mediump float;
+uniform sampler2D u_texture;
+in vec2 v_uv;
+out vec4 fragColor;
+void main() { fragColor = texture(u_texture, v_uv); }
+"""
+
+        private fun link(vertex: String, fragment: String): Int {
+            val vs = RNMBXPuck.compile(GLES30.GL_VERTEX_SHADER, vertex)
+            val fs = RNMBXPuck.compile(GLES30.GL_FRAGMENT_SHADER, fragment)
+            if (vs == 0 || fs == 0) return 0
+            val program = GLES30.glCreateProgram()
+            GLES30.glAttachShader(program, vs)
+            GLES30.glAttachShader(program, fs)
+            GLES30.glBindAttribLocation(program, 0, "a_corner")
+            GLES30.glLinkProgram(program)
+            GLES30.glDeleteShader(vs)
+            GLES30.glDeleteShader(fs)
+            val ok = IntArray(1)
+            GLES30.glGetProgramiv(program, GLES30.GL_LINK_STATUS, ok, 0)
+            if (ok[0] == 0) {
+                Log.e(TAG, "program link failed: ${GLES30.glGetProgramInfoLog(program)}")
+                GLES30.glDeleteProgram(program)
+                return 0
+            }
+            return program
+        }
+    }
+}
