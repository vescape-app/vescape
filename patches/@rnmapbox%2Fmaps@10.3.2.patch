+    } catch {
+      Logger.log(level: .error, message: "RNMBXPuck: layer update failed: \(error)")
+    }
+    map.triggerRepaint()
+  }
+
+  private final class Host: NSObject, CustomLayerHost {
+    private unowned let owner: RNMBXPuck
+    private var device: MTLDevice?
+    private var library: MTLLibrary?
+    private var pipeline: MTLRenderPipelineState?
+    private var depthState: MTLDepthStencilState?
+    private var pipelineKey = RNMBXPassFormat()
+    private var vertexBuffer: MTLBuffer?
+    private var uploadedVersion = 0
+    private var projection = [Double](repeating: 0, count: 16)
+    /// mvp (16) + metres per point (1), padded to the shader struct's 80 bytes.
+    private var uniforms = [Float](repeating: 0, count: 20)
+    private var loggedError = false
+
+    // Render-thread copy of the shared state.
+    private var sLng = 0.0
+    private var sLat = 0.0
+    private var sBearing = Double.nan
+    private var sArgb: UInt32 = 0
+    private var sShadowAlpha: Float = 0
+    private var sShown = false
+    private var sMarkers = false
+    private var sVersion = 0
+
+    init(owner: RNMBXPuck) {
+      self.owner = owner
+    }
+
+    func renderingWillStart(_ metalDevice: MTLDevice, colorPixelFormat: UInt, depthStencilPixelFormat: UInt) {
+      device = metalDevice
+      do {
+        library = try metalDevice.makeLibrary(source: RNMBXPuck.shaders, options: nil)
+      } catch {
+        Logger.log(level: .error, message: "RNMBXPuck: shader compile failed: \(error)")
+        library = nil
+      }
+      let depth = MTLDepthStencilDescriptor()
+      depth.depthCompareFunction = .always
+      depth.isDepthWriteEnabled = false
+      depthState = metalDevice.makeDepthStencilState(descriptor: depth)
+      pipeline = nil
+      vertexBuffer = nil
+      uploadedVersion = 0
+      owner.markers.renderingWillStart(metalDevice, library: library)
+    }
+
+    func render(_ parameters: CustomLayerRenderParameters, mtlCommandBuffer: MTLCommandBuffer, mtlRenderPassDescriptor: MTLRenderPassDescriptor) {
+      guard let device, let library, let depthState else { return }
+      owner.lock.lock()
+      sLng = owner.lng
+      sLat = owner.lat
+      sBearing = owner.bearing
+      sArgb = owner.argb
+      sShadowAlpha = owner.shadowAlpha
+      sShown = owner.shown
+      sVersion = owner.geometryVersion
+      sMarkers = !owner.markers.isEmpty
+      owner.lock.unlock()
+      if !sShown && !sMarkers { return }
+
+      let format = RNMBXPassFormat(mtlRenderPassDescriptor)
+      if pipeline == nil || format != pipelineKey {
+        pipeline = RNMBXPuck.makePipeline(device, library, format, vertex: "puck_vertex", fragment: "puck_fragment")
+        pipelineKey = format
+        if pipeline == nil { return }
+      }
+      guard let pipeline else { return }
+      if sShown && uploadedVersion != sVersion { upload(device) }
+
+      let matrix = parameters.projectionMatrix
+      for i in 0..<16 { projection[i] = matrix[i].doubleValue }
+
+      guard let encoder = mtlCommandBuffer.makeRenderCommandEncoder(descriptor: mtlRenderPassDescriptor) else {
+        if !loggedError {
+          Logger.log(level: .error, message: "RNMBXPuck: no render encoder")
+          loggedError = true
+        }
+        return
+      }
+      encoder.label = "rnmbx-puck"
+      encoder.setDepthStencilState(depthState)
+      encoder.setCullMode(.none)
+
+      // Painter's order, valid from any heading and pitch: the camera is always above the coin,
+      // so the top face covers everything under it; the wall is one flat shade, so its back and
+      // front halves need no sorting; the arrow lies in the top plane.
+      if sShown, let vertexBuffer {
+        let worldSize = 512.0 * pow(2.0, parameters.zoom)
+        let (x, y) = RNMBXPuck.worldPoint(lng: sLng, lat: sLat, worldSize: worldSize)
+        uniforms[16] = Float(cos(parameters.latitude * .pi / 180.0) * 2.0 * .pi * RNMBXPuck.earthRadius / worldSize)
+        // Screen-down on the ground: the map's bearing turns world north to screen up.
+        let mapBearing = parameters.bearing * .pi / 180.0
+        let dropX = -sin(mapBearing) * RNMBXPuck.shadowDrop
+        let dropY = cos(mapBearing) * RNMBXPuck.shadowDrop
+        encoder.setRenderPipelineState(pipeline)
+        encoder.setVertexBuffer(vertexBuffer, offset: 0, index: 0)
+        draw(encoder, x + dropX, y + dropY, 0, RNMBXPuck.shadowFirst, RNMBXPuck.discCount)
+        draw(encoder, x, y, 0, RNMBXPuck.bodyFirst, RNMBXPuck.bodyCount)
+        if !sBearing.isNaN { draw(encoder, x, y, sBearing * .pi / 180.0, RNMBXPuck.arrowFirst, RNMBXPuck.arrowCount) }
+        draw(encoder, x, y, 0, RNMBXPuck.topFirst, RNMBXPuck.topCount)
+      }
+      // Above the coin, as marker views stacked above it.
+      if sMarkers {
+        owner.markers.render(encoder, commandBuffer: mtlCommandBuffer, format: format, projection: projection, zoom: parameters.zoom)
+      }
+      encoder.endEncoding()
+    }
+
+    func renderingWillEnd() {
+      owner.markers.renderingWillEnd()
+      pipeline = nil
+      depthState = nil
+      vertexBuffer = nil
+      library = nil
+      device = nil
+      uploadedVersion = 0
+    }
+
+    /// projection * translate(x, y) * rotateZ(angle), column-major; translation in doubles.
+    private func draw(_ encoder: MTLRenderCommandEncoder, _ x: Double, _ y: Double, _ angle: Double, _ first: Int, _ count: Int) {
+      let c = cos(angle)
+      let s = sin(angle)
+      let p = projection
+      for r in 0..<4 {
+        uniforms[r] = Float(p[r] * c + p[4 + r] * s)
+        uniforms[4 + r] = Float(-p[r] * s + p[4 + r] * c)
+        uniforms[8 + r] = Float(p[8 + r])
+        uniforms[12 + r] = Float(p[r] * x + p[4 + r] * y + p[12 + r])
+      }
+      uniforms.withUnsafeBytes { encoder.setVertexBytes($0.baseAddress!, length: $0.count, index: 1) }
+      encoder.drawPrimitives(type: .triangle, vertexStart: first, vertexCount: count)
+    }
+
+    /// Rebuilds the vertex data; only when colour or shadow change. A new buffer each time, so a
+    /// frame still in flight keeps reading the old one.
+    private func upload(_ device: MTLDevice) {
+      let a = Float((sArgb >> 24) & 0xFF) / 255
+      let r = Float((sArgb >> 16) & 0xFF) / 255
+      let g = Float((sArgb >> 8) & 0xFF) / 255
+      let b = Float(sArgb & 0xFF) / 255
+      let shade = RNMBXPuck.wallShade
+      var v = [Float]()
+      v.reserveCapacity(RNMBXPuck.vertexCount * RNMBXPuck.stride)
+      RNMBXPuck.disc(&v, RNMBXPuck.shadowRadius, 0, 0, 0, 0, sShadowAlpha)
+      RNMBXPuck.disc(&v, RNMBXPuck.coinRadius, 0, r * shade, g * shade, b * shade, a)
+      RNMBXPuck.wall(&v, r * shade, g * shade, b * shade, a)
+      // Pointing north (world y is south); the draw rotates it clockwise by the bearing.
+      RNMBXPuck.vertex(&v, 0, -RNMBXPuck.arrowTip, RNMBXPuck.coinHeight, 1, 1, 1, 1)
+      RNMBXPuck.vertex(&v, RNMBXPuck.arrowHalfWidth, -RNMBXPuck.arrowBase, RNMBXPuck.coinHeight, 1, 1, 1, 1)
+      RNMBXPuck.vertex(&v, -RNMBXPuck.arrowHalfWidth, -RNMBXPuck.arrowBase, RNMBXPuck.coinHeight, 1, 1, 1, 1)
+      RNMBXPuck.disc(&v, RNMBXPuck.coinRadius, RNMBXPuck.coinHeight, 1, 1, 1, 1)
+      RNMBXPuck.disc(&v, RNMBXPuck.coinRadius - RNMBXPuck.rimWidth, RNMBXPuck.coinHeight, r, g, b, a)
+      vertexBuffer = v.withUnsafeBytes { device.makeBuffer(bytes: $0.baseAddress!, length: $0.count, options: .storageModeShared) }
+      uploadedVersion = sVersion
+    }
+  }
+
+  // MARK: - Shared with RNMBXMarkerSprites
+
+  static let maxLat = 85.051128
+
+  /// Web Mercator world position in points for a frame whose world is `worldSize` across.
+  static func worldPoint(lng: Double, lat: Double, worldSize: Double) -> (Double, Double) {
+    let latRad = min(max(lat, -maxLat), maxLat) * .pi / 180.0
+    let x = (lng + 180.0) / 360.0 * worldSize
+    let y = (1.0 - log(tan(latRad) + 1.0 / cos(latRad)) / .pi) / 2.0 * worldSize
+    return (x, y)
+  }
+
+  /// Premultiplied source-over, as both programs output; no depth test; formats of the map's pass.
+  static func makePipeline(_ device: MTLDevice, _ library: MTLLibrary, _ format: RNMBXPassFormat, vertex: String, fragment: String) -> MTLRenderPipelineState? {
+    let d = MTLRenderPipelineDescriptor()
+    d.vertexFunction = library.makeFunction(name: vertex)
+    d.fragmentFunction = library.makeFunction(name: fragment)
+    d.rasterSampleCount = format.sampleCount
+    let color = d.colorAttachments[0]!
+    color.pixelFormat = format.color
+    color.isBlendingEnabled = true
+    color.sourceRGBBlendFactor = .one
+    color.sourceAlphaBlendFactor = .one
+    color.destinationRGBBlendFactor = .oneMinusSourceAlpha
+    color.destinationAlphaBlendFactor = .oneMinusSourceAlpha
+    d.depthAttachmentPixelFormat = format.depth
+    d.stencilAttachmentPixelFormat = format.stencil
+    do {
+      return try device.makeRenderPipelineState(descriptor: d)
+    } catch {
+      Logger.log(level: .error, message: "RNMBXPuck: pipeline failed: \(error)")
+      return nil
+    }
+  }
+
+  // MARK: - Geometry
+
+  /// Layers added without a position go under this one, see `RNMBXLayer.attemptInsert`.
+  static let layerId = "rnmbx-puck"
+
+  // GpsPuck's coin, in points.
+  // @parity /src/modules/map/components/GpsPuck.tsx `COIN_SIZE`
+  // @parity /node_modules/@rnmapbox/maps/android/src/main/java/com/rnmapbox/rnmbx/components/camera/RNMBXPuck.kt `COIN_RADIUS`
+  private static let coinRadius: Float = 11
+  private static let coinHeight: Float = 12
+  private static let rimWidth: Float = 3
+  private static let shadowRadius: Float = 15
+  /// Towards the bottom of the screen.
+  private static let shadowDrop = 2.0
+  /// 40% black over the rider colour.
+  private static let wallShade: Float = 0.6
+  private static let arrowHalfWidth: Float = 9
+  private static let arrowLength: Float = 14
+  private static let arrowTuck: Float = 4
+  private static let arrowBase = coinRadius - arrowTuck
+  private static let arrowTip = arrowBase + arrowLength
+  private static let segments = 48
+  private static let earthRadius = 6378137.0
