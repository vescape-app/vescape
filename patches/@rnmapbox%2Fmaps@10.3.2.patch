+    }
+
+    /** Under the lock: the UI thread may be about to redraw the same bitmap. */
+    private fun upload(sprite: Sprite, bitmap: Bitmap) {
+        if (sprite.texture == 0) {
+            GLES30.glGenTextures(1, ids, 0)
