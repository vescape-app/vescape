+  private func stopFrames() {
+    displayLink?.invalidate()
+    displayLink = nil
+  }
+
+  /// Breaks the display link's strong reference back to the sprites.
+  private final class FrameTarget: NSObject {
+    weak var owner: RNMBXMarkerSprites?
+
+    init(_ owner: RNMBXMarkerSprites) {
+      self.owner = owner
+    }
+
+    @objc func onFrame() {
+      owner?.onFrame()
+    }
+  }
+
+  private func onFrame() {
+    let now = CACurrentMediaTime()
+    var live = false
+    lock.lock()
+    for sprite in sprites where sprite.burstUntil >= now {
+      snapshotLocked(sprite)
+      live = true
+    }
+    lock.unlock()
+    if live {
+      repaint()
+    } else {
+      stopFrames()
+    }
+  }
+
+  /// Main thread. Undoes `snapshotLocked`'s hiding.
+  private func show(_ sprite: Sprite) {
+    sprite.hidden?.layer.mask = nil
+    sprite.hidden = nil
+  }
+
+  /// Draws the ghost's tree, overflowing children included, into the sprite's bitmap.
+  private func snapshotLocked(_ sprite: Sprite) {
+    if sprite.view == nil { sprite.view = resolve(sprite.tag) }
+    guard let view = sprite.view, view.bounds.width > 0, view.bounds.height > 0 else { return }
+    let scale = view.window?.screen.scale ?? UIScreen.main.scale
+    var bounds = view.bounds
+    accumulate(view, root: view, into: &bounds)
+    let left = floor(bounds.minX * scale)
+    let top = floor(bounds.minY * scale)
+    let width = Int(ceil(bounds.maxX * scale) - left)
+    let height = Int(ceil(bounds.maxY * scale) - top)
+    if sprite.pixels == nil || sprite.width != width || sprite.height != height {
+      sprite.pixels?.deallocate()
+      sprite.pixels = UnsafeMutableRawPointer.allocate(byteCount: width * height * 4, alignment: 16)
+      sprite.width = width
+      sprite.height = height
+    }
+    guard let pixels = sprite.pixels else { return }
+    memset(pixels, 0, width * height * 4)
+    guard let context = CGContext(
+      data: pixels,
+      width: width,
+      height: height,
+      bitsPerComponent: 8,
+      bytesPerRow: width * 4,
+      space: Self.colorSpace,
+      bitmapInfo: CGImageAlphaInfo.premultipliedFirst.rawValue | CGBitmapInfo.byteOrder32Little.rawValue
+    ) else { return }
+    // Row 0 of the buffer is the top of the view, as the texture reads it.
+    context.translateBy(x: 0, y: CGFloat(height))
+    context.scaleBy(x: 1, y: -1)
+    context.translateBy(x: -left, y: -top)
+    context.scaleBy(x: scale, y: scale)
