+        if (sprite.hide && sprite.hidden == null) {
+            view.alpha = 0f
+            sprite.hidden = WeakReference(view)
+        }
+    }
+
+    /** Grows [bounds] by every visible descendant, with each child's own transform. */
+    private fun accumulate(view: View, dx: Float, dy: Float) {
+        if (view !is ViewGroup) return
+        for (index in 0 until view.childCount) {
+            val child = view.getChildAt(index)
+            if (child.visibility != View.VISIBLE) continue
