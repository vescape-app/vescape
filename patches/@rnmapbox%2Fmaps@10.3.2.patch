+      if candidate is RNMBXMarkerViewParentViewAnnotation { return candidate }
+      next = candidate.superview
+    }
+    return nil
+  }
+
+  /// Grows `bounds` by every visible descendant, with each one's own transform.
+  private func accumulate(_ view: UIView, root: UIView, into bounds: inout CGRect) {
+    for child in view.subviews where !child.isHidden {
+      bounds = bounds.union(child.convert(child.bounds, to: root))
+      accumulate(child, root: root, into: &bounds)
+    }
+  }
+
+  // MARK: - Render side
+
+  private var device: MTLDevice?
+  private var library: MTLLibrary?
+  private var pipeline: MTLRenderPipelineState?
+  private var pipelineKey = RNMBXPassFormat()
+  /// clip (4), viewport (2) + padding (2), rect (4), as the shader's struct lays them out.
+  private var uniforms = [Float](repeating: 0, count: 12)
+
+  func renderingWillStart(_ device: MTLDevice, library: MTLLibrary?) {
+    self.device = device
+    self.library = library
+    pipeline = nil
+  }
+
+  /**
+   Called by the puck's host inside its encoder, after the coin. `projection` is the frame's
+   world-point projection.
+   */
+  func render(_ encoder: MTLRenderCommandEncoder, commandBuffer: MTLCommandBuffer, format: RNMBXPassFormat, projection p: [Double], zoom: Double) {
+    guard let device, let library, format.width > 0, format.height > 0 else { return }
+    if pipeline == nil || format != pipelineKey {
+      pipeline = RNMBXPuck.makePipeline(device, library, format, vertex: "sprite_vertex", fragment: "sprite_fragment")
+      pipelineKey = format
+    }
+    guard let pipeline else { return }
+    lock.lock()
+    defer { lock.unlock() }
+    if sprites.isEmpty { return }
+    encoder.setRenderPipelineState(pipeline)
+    uniforms[4] = Float(format.width)
+    uniforms[5] = Float(format.height)
+    let worldSize = 512.0 * pow(2.0, zoom)
+    var read: [TextureSlot] = []
+    var waiting = false
+    for sprite in sprites {
+      if sprite.dirty && !upload(sprite, device) { waiting = true }
+      guard let slot = sprite.current else { continue }
+      let texture = slot.texture
+      let (x, y) = RNMBXPuck.worldPoint(lng: sprite.lng, lat: sprite.lat, worldSize: worldSize)
+      let w = p[3] * x + p[7] * y + p[15]
+      // Behind the camera: nothing on screen to draw.
+      if w <= 0 { continue }
+      uniforms[0] = Float(p[0] * x + p[4] * y + p[12])
+      uniforms[1] = Float(p[1] * x + p[5] * y + p[13])
+      uniforms[2] = 0
+      uniforms[3] = Float(w)
+      uniforms[8] = -sprite.anchorX
+      uniforms[9] = -sprite.anchorY
+      uniforms[10] = Float(texture.width)
+      uniforms[11] = Float(texture.height)
+      uniforms.withUnsafeBytes { encoder.setVertexBytes($0.baseAddress!, length: $0.count, index: 0) }
+      encoder.setFragmentTexture(texture, index: 0)
+      encoder.drawPrimitives(type: .triangleStrip, vertexStart: 0, vertexCount: 4)
+      slot.reads += 1
+      read.append(slot)
+    }
+    // Busy until the GPU is done with this frame; only then may an upload overwrite them.
+    // A waiting upload goes in on the frame after.
+    let repaint = waiting ? self.repaint : nil
+    if read.isEmpty {
+      if let repaint { DispatchQueue.main.async(execute: repaint) }
+      return
+    }
+    let lock = self.lock
+    commandBuffer.addCompletedHandler { _ in
+      lock.lock()
+      for slot in read { slot.reads -= 1 }
+      lock.unlock()
+      if let repaint { DispatchQueue.main.async(execute: repaint) }
+    }
+  }
+
+  /// Under the lock: the main thread may be about to redraw the same bitmap. Writes a texture no
+  /// command buffer reads any more, so a frame in flight keeps the one it was given. With every
+  /// texture of a full pool still in flight, the upload waits for the next frame.
+  /// Returns false when it has to wait.
+  private func upload(_ sprite: Sprite, _ device: MTLDevice) -> Bool {
+    guard let pixels = sprite.pixels else { return true }
+    var slot = sprite.slots.first {
+      $0.reads == 0 && $0.texture.width == sprite.width && $0.texture.height == sprite.height
+    }
+    if slot == nil {
+      // Any free texture left is of an old size and gives way; otherwise the pool grows up to its
+      // limit.
+      let stale = sprite.slots.firstIndex { $0.reads == 0 }
+      if stale == nil && sprite.slots.count >= Self.texturePool { return false }
+      let d = MTLTextureDescriptor.texture2DDescriptor(
+        pixelFormat: .bgra8Unorm, width: sprite.width, height: sprite.height, mipmapped: false
+      )
+      d.usage = .shaderRead
+      guard let texture = device.makeTexture(descriptor: d) else { return true }
+      if let stale { sprite.slots.remove(at: stale) }
+      slot = TextureSlot(texture)
+      sprite.slots.append(slot!)
+    }
+    guard let slot else { return true }
+    slot.texture.replace(
+      region: MTLRegionMake2D(0, 0, sprite.width, sprite.height),
+      mipmapLevel: 0,
+      withBytes: pixels,
+      bytesPerRow: sprite.width * 4
+    )
+    sprite.current = slot
+    sprite.dirty = false
+    return true
+  }
+
+  func renderingWillEnd() {
+    // Textures die with the device; the bitmaps are still here and upload again.
+    lock.lock()
+    for sprite in byTag.values {
+      sprite.slots = []
+      sprite.current = nil
+      sprite.dirty = sprite.pixels != nil
+    }
+    lock.unlock()
+    pipeline = nil
+    library = nil
+    device = nil
+  }
+
+  /// Doubles per marker in `set`.
+  private static let stride = 6
+  /// Textures per sprite at most: enough for the frames Metal keeps in flight.
+  private static let texturePool = 4
+  private static let colorSpace = CGColorSpace(name: CGColorSpace.sRGB)!
+}
