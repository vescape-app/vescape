+      // Empty, so nothing of the host draws; render(in:) above starts below it.
+      let mask = CALayer()
+      host.layer.mask = mask
+      sprite.hidden = host
+    }
+  }
+
+  /// The view annotation hosting a ghost: owned by the marker view, never by Fabric, which
+  /// resets the masks of its own views.
+  private static func host(of view: UIView) -> UIView? {
+    var next = view.superview
