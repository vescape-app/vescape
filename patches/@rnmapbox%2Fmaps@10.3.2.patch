+final class RNMBXMarkerSprites {
+  private final class Sprite {
+    let tag: Int
+    weak var view: UIView?
+    var lng = 0.0
+    var lat = 0.0
+    var version = Double.nan
+    var burstUntil: CFTimeInterval = 0
+    /// JS wants the ghost hidden on screen.
+    var hide = false
+    /// The host this class has masked, to unmask when that changes.
+    weak var hidden: UIView?
+    // Written on the main thread, uploaded on the render side, both under the lock.
+    var pixels: UnsafeMutableRawPointer?
+    var width = 0
+    var height = 0
+    /// The coordinate's position inside the bitmap, in pixels from its top-left corner.
+    var anchorX: Float = 0
+    var anchorY: Float = 0
+    var dirty = false
+    // Render side only.
+    var slots: [TextureSlot] = []
+    var current: TextureSlot?
+
+    init(tag: Int) {
+      self.tag = tag
+    }
+
+    deinit {
+      pixels?.deallocate()
+    }
+  }
+
+  /// A sprite texture, and how many command buffers still read it. Guarded by the lock.
+  private final class TextureSlot {
+    let texture: MTLTexture
+    var reads = 0
+
+    init(_ texture: MTLTexture) {
+      self.texture = texture
+    }
+  }
+
+  private let lock: NSLock
+  var repaint: () -> Void = {}
+  private var sprites: [Sprite] = []
+  private var byTag: [Int: Sprite] = [:]
+
+  // Main thread.
+  private var displayLink: CADisplayLink?
+  /// The last resolver JS's call came with; a ghost can mount after its first snapshot request.
+  private var resolve: (Int) -> UIView? = { _ in nil }
+
+  init(lock: NSLock) {
+    self.lock = lock
+  }
+
+  deinit {
+    displayLink?.invalidate()
+  }
+
+  /// Guarded by the lock.
+  var isEmpty: Bool { sprites.isEmpty }
+
+  /// Main thread. `values` is `[tag, lng, lat, version, burstMs, hide]` per marker, in draw order;
+  /// `resolve` finds a ghost view by its React tag.
+  func set(_ values: [Double], resolve: @escaping (Int) -> UIView?) {
+    self.resolve = resolve
+    let now = CACurrentMediaTime()
+    var changed: [Sprite] = []
+    lock.lock()
+    var keep = Set<Int>()
+    sprites.removeAll(keepingCapacity: true)
