+    // Void like setCameraDirect: it is issued alongside camera writes, and a
+    // promise per call buys nothing the caller can act on.
+    RCTPromiseRejectBlock reject = ^(NSString *code, NSString *message, NSError *error) {
+        NSLog(@"cancelCameraAnimations: %@ %@", code, message);
+    };
+    [self withCamera:viewRef block:^(RNMBXCamera *view) {
+        [view cancelCameraAnimations];
