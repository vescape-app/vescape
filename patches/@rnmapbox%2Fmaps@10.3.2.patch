+            val gone = byTag.values.filter { it.tag !in keep }
+            for (sprite in gone) {
+                byTag.remove(sprite.tag)
+                show(sprite)
+                if (sprite.texture != 0) retired.add(sprite.texture)
+            }
+        }
+        for (sprite in changed) snapshot(sprite)
+        if (changed.isNotEmpty()) scheduleFrame()
+    }
+
+    /** UI thread. Drops every sprite, e.g. when the camera leaves the map. */
+    fun clear() {
+        resolve = { null }
+        synchronized(lock) {
+            for (sprite in byTag.values) {
+                show(sprite)
+                if (sprite.texture != 0) retired.add(sprite.texture)
+            }
+            sprites.clear()
+            byTag.clear()
+        }
+    }
+
+    private fun scheduleFrame() {
+        if (frameScheduled) return
+        frameScheduled = true
+        Choreographer.getInstance().postFrameCallback(frame)
+    }
+
+    private fun onFrame() {
+        frameScheduled = false
+        val now = SystemClock.uptimeMillis()
+        var live = false
+        synchronized(lock) {
+            for (sprite in sprites) {
+                if (sprite.burstUntil < now) continue
+                snapshotLocked(sprite)
+                live = true
+            }
+        }
+        if (live) {
+            repaint()
+            scheduleFrame()
+        }
+    }
+
+    private fun snapshot(sprite: Sprite) {
+        synchronized(lock) { snapshotLocked(sprite) }
+        repaint()
+    }
+
+    /** UI thread. Undoes [snapshotLocked]'s hiding. */
+    private fun show(sprite: Sprite) {
+        sprite.hidden?.get()?.alpha = 1f
+        sprite.hidden = null
+    }
+
+    /** Draws the ghost's tree, overflowing children included, into the sprite's bitmap. */
+    private fun snapshotLocked(sprite: Sprite) {
+        if (sprite.view?.get() == null) sprite.view = resolve(sprite.tag)?.let { WeakReference(it) }
+        val view = sprite.view?.get() ?: return
+        if (view.width == 0 || view.height == 0) return
+        bounds.set(0f, 0f, view.width.toFloat(), view.height.toFloat())
+        accumulate(view, 0f, 0f)
+        val left = floor(bounds.left)
+        val top = floor(bounds.top)
+        val width = (ceil(bounds.right) - left).toInt()
+        val height = (ceil(bounds.bottom) - top).toInt()
+        var bitmap = sprite.bitmap
+        if (bitmap == null || bitmap.width != width || bitmap.height != height) {
+            bitmap = Bitmap.createBitmap(width, height, Bitmap.Config.ARGB_8888)
+            sprite.bitmap = bitmap
+        } else {
+            bitmap.eraseColor(0)
+        }
+        var software = true
+        canvas.setBitmap(bitmap)
+        val saveCount = canvas.save()
+        try {
+            canvas.translate(-left, -top)
+            // View.draw leaves out the view's own alpha, which is how the ghost hides on screen.
+            view.draw(canvas)
+        } catch (e: IllegalArgumentException) {
+            // A hardware bitmap (a decoded photo) cannot go on a software canvas.
+            software = false
+        } finally {
+            canvas.restoreToCount(saveCount)
+            canvas.setBitmap(null)
+        }
+        if (!software) {
