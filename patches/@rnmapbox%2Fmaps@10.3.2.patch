+            child.matrix.mapRect(childRect)
+            val x = dx + child.left
+            val y = dy + child.top
+            childRect.offset(x, y)
+            bounds.union(childRect)
+            accumulate(child, x, y)
+        }
+    }
+
+    // Render thread.
+    private val quad =
+        ByteBuffer.allocateDirect(8 * 4).order(ByteOrder.nativeOrder()).asFloatBuffer().apply {
+            put(floatArrayOf(0f, 0f, 1f, 0f, 0f, 1f, 1f, 1f))
+            flip()
+        }
+    private val viewport = IntArray(4)
+    private val ids = IntArray(1)
+    private var program = 0
+    private var clipLocation = -1
+    private var viewportLocation = -1
+    private var rectLocation = -1
+    private var textureLocation = -1
+    private var vao = 0
+    private var buffer = 0
+
+    fun initialize() {
+        program = link(VERTEX_SHADER, FRAGMENT_SHADER)
+        if (program == 0) return
+        clipLocation = GLES30.glGetUniformLocation(program, "u_clip")
+        viewportLocation = GLES30.glGetUniformLocation(program, "u_viewport")
+        rectLocation = GLES30.glGetUniformLocation(program, "u_rect")
+        textureLocation = GLES30.glGetUniformLocation(program, "u_texture")
+        GLES30.glGenVertexArrays(1, ids, 0)
+        vao = ids[0]
+        GLES30.glGenBuffers(1, ids, 0)
+        buffer = ids[0]
+        GLES30.glBindVertexArray(vao)
+        GLES30.glBindBuffer(GLES30.GL_ARRAY_BUFFER, buffer)
+        GLES30.glBufferData(GLES30.GL_ARRAY_BUFFER, 8 * 4, quad, GLES30.GL_STATIC_DRAW)
+        GLES30.glEnableVertexAttribArray(0)
+        GLES30.glVertexAttribPointer(0, 2, GLES30.GL_FLOAT, false, 2 * 4, 0)
+    }
+
+    /**
+     * Called by the puck's host with its GL state saved and blending set up, VAO and array
+     * buffer free to change. [projection] is the frame's world-pixel projection.
+     */
+    fun render(projection: DoubleArray, zoom: Double) {
+        if (program == 0) return
