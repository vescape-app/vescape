+  // Buffer layout, in draw order.
+  private static let stride = 7
+  private static let discCount = 3 * segments
+  private static let shadowFirst = 0
+  private static let bodyFirst = shadowFirst + discCount // base disc + side wall
+  private static let bodyCount = discCount + 6 * segments
+  private static let arrowFirst = bodyFirst + bodyCount
+  private static let arrowCount = 3
+  private static let topFirst = arrowFirst + arrowCount // white rim disc + colour disc
+  private static let topCount = 2 * discCount
+  private static let vertexCount = topFirst + topCount
+
+  /// Both programs of the layer: the coin, and the marker sprites (`RNMBXMarkerSprites`).
+  private static let shaders = """
+#include <metal_stdlib>
+using namespace metal;
+
+struct PuckUniforms { float4x4 mvp; float metersPerPoint; };
+struct PuckOut { float4 position [[position]]; float4 color; };
+
+vertex PuckOut puck_vertex(uint vid [[vertex_id]],
+                           const device float *v [[buffer(0)]],
+                           constant PuckUniforms &u [[buffer(1)]]) {
+  const device float *p = v + vid * 7;
+  PuckOut out;
+  out.position = u.mvp * float4(p[0], p[1], p[2] * u.metersPerPoint, 1.0);
+  // Clip depth pinned inside [0, w]: the puck is an overlay, never depth-tested.
+  out.position.z = 0.0;
+  out.color = float4(p[3], p[4], p[5], p[6]);
+  return out;
+}
+
+fragment float4 puck_fragment(PuckOut in [[stage_in]]) { return in.color; }
+
+// The coordinate is projected on the CPU in doubles; the shader snaps it to a whole pixel and
+// spans the bitmap 1:1 from there, with y flipped from screen-down to clip-up.
+struct SpriteUniforms { float4 clip; float2 viewport; float4 rect; };
+struct SpriteOut { float4 position [[position]]; float2 uv; };
+
+vertex SpriteOut sprite_vertex(uint vid [[vertex_id]], constant SpriteUniforms &u [[buffer(0)]]) {
+  float2 corner = float2(float(vid & 1), float(vid >> 1));
+  float2 anchor = floor((u.clip.xy / u.clip.w * 0.5 + 0.5) * u.viewport + 0.5);
+  float2 offset = u.rect.xy + corner * u.rect.zw;
+  float2 pixel = anchor + float2(offset.x, -offset.y);
+  SpriteOut out;
+  out.position = float4(pixel / u.viewport * 2.0 - 1.0, 0.0, 1.0);
+  out.uv = corner;
+  return out;
+}
+
+// The bitmap is premultiplied, as the pipeline's blend expects.
+fragment float4 sprite_fragment(SpriteOut in [[stage_in]], texture2d<float> t [[texture(0)]]) {
+  constexpr sampler s(filter::linear, address::clamp_to_edge);
+  return t.sample(s, in.uv);
+}
+"""
+
+  /// Premultiplied colour.
+  private static func vertex(_ v: inout [Float], _ x: Float, _ y: Float, _ z: Float, _ r: Float, _ g: Float, _ b: Float, _ a: Float) {
+    v.append(contentsOf: [x, y, z, r * a, g * a, b * a, a])
+  }
+
+  private static func ringX(_ i: Int, _ radius: Float) -> Float {
+    Float(cos(2.0 * .pi * Double(i) / Double(segments))) * radius
+  }
+
+  private static func ringY(_ i: Int, _ radius: Float) -> Float {
+    Float(sin(2.0 * .pi * Double(i) / Double(segments))) * radius
+  }
+
+  private static func disc(_ v: inout [Float], _ radius: Float, _ z: Float, _ r: Float, _ g: Float, _ b: Float, _ a: Float) {
+    for i in 0..<segments {
+      vertex(&v, 0, 0, z, r, g, b, a)
+      vertex(&v, ringX(i, radius), ringY(i, radius), z, r, g, b, a)
+      vertex(&v, ringX(i + 1, radius), ringY(i + 1, radius), z, r, g, b, a)
+    }
+  }
+
+  private static func wall(_ v: inout [Float], _ r: Float, _ g: Float, _ b: Float, _ a: Float) {
+    for i in 0..<segments {
+      let x0 = ringX(i, coinRadius), y0 = ringY(i, coinRadius)
+      let x1 = ringX(i + 1, coinRadius), y1 = ringY(i + 1, coinRadius)
+      vertex(&v, x0, y0, 0, r, g, b, a)
+      vertex(&v, x1, y1, 0, r, g, b, a)
+      vertex(&v, x1, y1, coinHeight, r, g, b, a)
+      vertex(&v, x0, y0, 0, r, g, b, a)
+      vertex(&v, x1, y1, coinHeight, r, g, b, a)
+      vertex(&v, x0, y0, coinHeight, r, g, b, a)
+    }
+  }
+}
+
+/// The attachment formats of the map's render pass, which a pipeline has to match.
+struct RNMBXPassFormat: Equatable {
+  var color: MTLPixelFormat = .invalid
+  var depth: MTLPixelFormat = .invalid
+  var stencil: MTLPixelFormat = .invalid
+  var sampleCount = 1
+  /// Drawable size in pixels.
+  var width = 0
+  var height = 0
+
+  init() {}
+
+  init(_ pass: MTLRenderPassDescriptor) {
+    if let texture = pass.colorAttachments[0].texture {
+      color = texture.pixelFormat
+      sampleCount = texture.sampleCount
+      width = texture.width
+      height = texture.height
+    }
+    depth = pass.depthAttachment.texture?.pixelFormat ?? .invalid
+    stencil = pass.stencilAttachment.texture?.pixelFormat ?? .invalid
+  }
+
+  static func == (a: Self, b: Self) -> Bool {
+    a.color == b.color && a.depth == b.depth && a.stencil == b.stencil && a.sampleCount == b.sampleCount
+  }
+}
