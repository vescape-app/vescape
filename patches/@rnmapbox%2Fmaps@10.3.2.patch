+            // A mutable copy: the next snapshot erases it and draws into it.
+            sprite.bitmap = rendered.copy(Bitmap.Config.ARGB_8888, true)
+            rendered.recycle()
+            bitmap.recycle()
+        }
+        // The marker view centres the ghost on the coordinate.
+        sprite.anchorX = view.width / 2f - left
+        sprite.anchorY = view.height / 2f - top
