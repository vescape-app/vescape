+import Foundation
+import MapboxMaps
+import Metal
+
+/**
+ The rider puck as a Mapbox custom layer: the coin of GpsPuck (src/modules/map/components/GpsPuck.tsx)
+ drawn with Metal inside the map's own render pass, so it moves with the map in the same frame
+ instead of trailing it like a marker view. Ground shadow, shaded base and side wall, heading
+ arrow in the top face's plane, top face with a white rim.
+
+ Units, as Mapbox's projection matrix takes them: x/y are world points with 512 pt tiles
+ (512 * 2^zoom across the world), so the coin keeps its on-screen size at any zoom. z is in
+ metres, so the vertex shader turns the coin's point heights into metres with the
+ metres-per-point at the camera's latitude. Column-major. No depth test: the coin is an overlay,
+ drawn back to front (painter's order in `render`).
+
+ The same layer draws the app's in-map markers (`RNMBXMarkerSprites`) after the coin, so one
+ layer keeps all of them above the style's layers and in a fixed order among themselves.
+
+ Written on the main thread by `set` and `setMarkers`, read by the layer host on the render
+ thread, under `lock`. The layer is persistent, so Mapbox keeps it across style reloads; it is
+ added on first use and removed when neither the puck nor a marker is left. Mercator only: under
+ globe projection (zoom below ~5) the coin and markers are misplaced.
+
+ @parity /node_modules/@rnmapbox/maps/android/src/main/java/com/rnmapbox/rnmbx/components/camera/RNMBXPuck.kt
+ @parity /src/modules/map/lib/nativePuck.ts `PuckLayerState`
+ */
+final class RNMBXPuck {
+  private let lock: NSLock
+  private var lng = 0.0
+  private var lat = 0.0
+  private var bearing = Double.nan
+  private var argb: UInt32 = 0
+  private var shadowAlpha: Float = 0
+  private var shown = false
+  /// Bumped when the vertex data (colour or shadow) changes. Bearing is a draw-time rotation.
+  private var geometryVersion = 1
+
+  private weak var map: MapboxMap?
+  private let markers: RNMBXMarkerSprites
+  private lazy var host = Host(owner: self)
+
+  init() {
+    let lock = NSLock()
+    self.lock = lock
+    markers = RNMBXMarkerSprites(lock: lock)
+    markers.repaint = { [weak self] in self?.map?.triggerRepaint() }
+  }
+
+  /// Main thread. NaN bearing hides the arrow; `visible` false (or a NaN position) removes the layer.
+  func set(map: MapboxMap, lng: Double, lat: Double, bearing: Double, argb: UInt32, shadowAlpha: Float, visible: Bool) {
+    let show = visible && !lng.isNaN && !lat.isNaN
+    lock.lock()
+    if show && (argb != self.argb || shadowAlpha != self.shadowAlpha || !shown) {
+      geometryVersion += 1
+    }
+    let moved = show && (lng != self.lng || lat != self.lat || !shown)
+    if show {
+      self.lng = lng
+      self.lat = lat
+      self.bearing = bearing
+      self.argb = argb
+      self.shadowAlpha = shadowAlpha
+    }
+    shown = show
+    lock.unlock()
+    self.map = map
+    apply(map, keepOnTop: moved)
+  }
+
+  /// Main thread. `values` is `[tag, lng, lat, version, burstMs, hide]` per marker view, in draw order;
+  /// `resolve` finds a marker's ghost view by its React tag.
+  func setMarkers(map: MapboxMap, values: [Double], resolve: @escaping (Int) -> UIView?) {
+    self.map = map
+    markers.set(values, resolve: resolve)
+    apply(map, keepOnTop: true)
+  }
+
+  /// Main thread. Takes the layer out of the map; a later `set` puts it back.
+  func remove(map: MapboxMap?) {
+    lock.lock()
+    shown = false
+    lock.unlock()
+    markers.clear()
+    guard let map, map.isStyleLoaded, map.layerExists(withId: Self.layerId) else { return }
+    try? map.removeLayer(withId: Self.layerId)
+  }
+
+  /// Puts the layer in the style or takes it out, to match the last `set`.
+  private func apply(_ map: MapboxMap, keepOnTop: Bool) {
+    guard map.isStyleLoaded else { return }
+    let exists = map.layerExists(withId: Self.layerId)
+    lock.lock()
+    let empty = !shown && markers.isEmpty
+    lock.unlock()
+    if empty {
+      if exists { try? map.removeLayer(withId: Self.layerId) }
+      return
+    }
+    do {
+      if !exists {
+        try map.addPersistentCustomLayer(withId: Self.layerId, layerHost: host, layerPosition: nil)
+      } else if keepOnTop && map.allLayerIdentifiers.last?.id != Self.layerId {
+        // Layers the app adds later (trails, routes) land above it; the puck and markers stay on
+        // top. Only on a position or marker change, never per bearing sample: listing layers
+        // allocates.
+        try map.moveLayer(withId: Self.layerId, to: .default)
