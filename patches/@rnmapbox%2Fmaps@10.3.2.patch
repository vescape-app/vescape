+/**
+ * Marker views drawn inside the map's own render pass, so they move with the map in the same
+ * frame instead of trailing it. JS keeps rendering each marker as a marker view (the "ghost"),
+ * which stays the look and the touch target; this class snapshots the ghost's view tree into a
+ * bitmap and draws it as a screen-aligned sprite at the marker's coordinate, centred like the
+ * marker view's default anchor and snapped to whole pixels so it stays crisp. Once a snapshot is
+ * in, a ghost JS marks hidden is hidden on screen through its alpha, which neither `View.draw` nor
+ * touch dispatch looks at.
+ *
+ * Snapshots are taken on the UI thread only when JS reports a change (a new `version`), then every
+ * frame for `burstMs` after it, which covers the mount landing a frame late (the ghost is looked
+ * up again until it is there), entering animations, pressed feedback and image decodes. The render thread uploads a snapshot once and then only
+ * draws the texture.
+ *
+ * State is shared with [RNMBXPuck] under its lock; the puck's layer host calls [initialize],
+ * [render], [contextLost] and [deinitialize]. Draw order is the order JS sends.
+ *
+ * @parity /src/components/map/markerLayerChannel.ts `createMarkerLayerChannel`
+ * @parity /node_modules/@rnmapbox/maps/ios/RNMBX/RNMBXMarkerSprites.swift
+ * @platform-diff The ghost hides through its own alpha here; on iOS a hit test skips a view under
+ * 1% alpha, so there the view annotation that hosts the ghost is masked instead.
+ */
+internal class RNMBXMarkerSprites(private val lock: Any, private val repaint: () -> Unit) {
+    private class Sprite(val tag: Int) {
+        var view: WeakReference<View>? = null
+        var lng = 0.0
+        var lat = 0.0
+        var version = Double.NaN
+        var burstUntil = 0L
+        /** JS wants the ghost hidden on screen. */
+        var hide = false
+        /** The ghost this class has hidden, to show again when that changes. */
+        var hidden: WeakReference<View>? = null
+        // Written on the UI thread, uploaded on the render thread, both under the lock.
+        var bitmap: Bitmap? = null
+        /** The coordinate's position inside [bitmap], in pixels from its top-left corner. */
+        var anchorX = 0f
+        var anchorY = 0f
+        var dirty = false
+        // Render thread only.
+        var texture = 0
+        var textureWidth = 0
+        var textureHeight = 0
+    }
+
+    private val sprites = ArrayList<Sprite>()
+    private val byTag = HashMap<Int, Sprite>()
+    /** Textures of removed sprites, deleted on the render thread. */
+    private val retired = ArrayList<Int>()
+
+    // UI thread scratch.
+    private val bounds = RectF()
+    private val childRect = RectF()
+    private val canvas = Canvas()
+    private var frameScheduled = false
+    private val frame = Choreographer.FrameCallback { onFrame() }
+    /** The last resolver JS's call came with; a ghost can mount after its first snapshot request. */
+    private var resolve: (Int) -> View? = { null }
+
+    /** Guarded by the lock. */
+    val isEmpty: Boolean
+        get() = sprites.isEmpty()
+
+    /**
+     * UI thread. [values] is `[tag, lng, lat, version, burstMs, hide]` per marker, in draw order;
+     * [resolve] finds a ghost view by its React tag.
+     */
+    fun set(values: DoubleArray, resolve: (Int) -> View?) {
+        this.resolve = resolve
+        val now = SystemClock.uptimeMillis()
+        val changed = ArrayList<Sprite>()
+        synchronized(lock) {
+            val keep = HashSet<Int>()
+            sprites.clear()
+            var i = 0
+            while (i + STRIDE <= values.size) {
+                val tag = values[i].toInt()
+                val sprite = byTag.getOrPut(tag) { Sprite(tag) }
+                sprite.lng = values[i + 1]
+                sprite.lat = values[i + 2]
+                sprite.hide = values[i + 5] != 0.0
+                if (!sprite.hide) show(sprite)
+                val version = values[i + 3]
+                if (version != sprite.version) {
+                    sprite.version = version
+                    sprite.burstUntil = now + values[i + 4].toLong()
+                    changed.add(sprite)
+                }
+                sprites.add(sprite)
+                keep.add(tag)
+                i += STRIDE
