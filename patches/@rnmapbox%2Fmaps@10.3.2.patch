+package com.rnmapbox.rnmbx.components.camera
+
+import android.opengl.GLES30
+import android.util.Log
+import com.mapbox.maps.CustomLayerHost
+import com.mapbox.maps.CustomLayerRenderParameters
+import com.mapbox.maps.LayerPosition
+import com.mapbox.maps.MapboxMap
+import java.nio.ByteBuffer
+import java.nio.ByteOrder
+import kotlin.math.PI
+import kotlin.math.cos
+import kotlin.math.ln
+import kotlin.math.pow
+import kotlin.math.sin
+import kotlin.math.tan
+
+/**
+ * The rider puck as a Mapbox custom layer: the coin of GpsPuck (src/modules/map/components/GpsPuck.tsx)
+ * drawn with GLES 3 inside the map's own render pass, so it moves with the map in the same frame
+ * instead of trailing it like a marker view. Ground shadow, shaded base and side wall, heading
+ * arrow in the top face's plane, top face with a white rim.
+ *
+ * Units, as Mapbox's projection matrix takes them: x/y are world pixels with 512 px tiles
+ * (512 * 2^zoom across the world), which are dp on the ground plane, so the coin keeps its
+ * on-screen size at any zoom. z is in metres, so the vertex shader turns the coin's dp heights
+ * into metres with the metres-per-pixel at the camera's latitude. Column-major.
+ * No depth test: the coin is an overlay, drawn back to front (painter's order in [render]).
+ *
+ * Written on the UI thread by [set], read on the render thread by the layer host. The layer is
+ * persistent, so Mapbox keeps it across style reloads; it is added on first use and removed when
+ * hidden. Mercator only: under globe projection (zoom below ~5) the coin is misplaced.
+ *
+ * @parity /src/modules/map/lib/nativePuck.ts `PuckLayerState`
+ * @parity /node_modules/@rnmapbox/maps/ios/RNMBX/RNMBXCameraModule.mm `setPuckDirect`
+ * @platform-diff Android only; iOS keeps the marker-view puck.
+ */
+internal class RNMBXPuck {
+    private val lock = Any()
+    private var lng = 0.0
+    private var lat = 0.0
+    private var bearing = Double.NaN
+    private var argb = 0
+    private var shadowAlpha = 0f
+    private var shown = false
+    /** Bumped when the vertex data (colour or shadow) changes. Bearing is a draw-time rotation. */
+    private var geometryVersion = 1L
+
+    private val host = Host()
+
+    /** UI thread. NaN bearing hides the arrow; `visible` false (or a NaN position) removes the layer. */
+    fun set(
+        map: MapboxMap,
+        lng: Double,
+        lat: Double,
+        bearing: Double,
+        argb: Int,
+        shadowAlpha: Float,
+        visible: Boolean,
+    ) {
+        val show = visible && !lng.isNaN() && !lat.isNaN()
+        val moved: Boolean
+        synchronized(lock) {
+            if (show && (argb != this.argb || shadowAlpha != this.shadowAlpha || !shown)) {
+                geometryVersion++
+            }
+            moved = show && (lng != this.lng || lat != this.lat || !shown)
+            if (show) {
+                this.lng = lng
+                this.lat = lat
+                this.bearing = bearing
+                this.argb = argb
+                this.shadowAlpha = shadowAlpha
+            }
+            shown = show
+        }
+        apply(map, keepOnTop = moved)
+    }
+
+    /** UI thread. Takes the layer out of the map; a later [set] puts it back. */
+    fun remove(map: MapboxMap?) {
+        synchronized(lock) { shown = false }
+        val style = map?.style ?: return
+        if (style.styleLayerExists(LAYER_ID)) style.removeStyleLayer(LAYER_ID)
+    }
+
+    /** Puts the layer in the style or takes it out, to match the last [set]. */
+    private fun apply(map: MapboxMap, keepOnTop: Boolean) {
+        val style = map.style ?: return
+        val exists = style.styleLayerExists(LAYER_ID)
+        if (!shown) {
+            if (exists) style.removeStyleLayer(LAYER_ID)
+            return
+        }
+        if (!exists) {
+            style.addPersistentStyleCustomLayer(LAYER_ID, host, TOP).error?.let {
+                Log.e(TAG, "add layer failed: $it")
+            }
+        } else if (keepOnTop && style.styleLayers.lastOrNull()?.id != LAYER_ID) {
+            // Layers the app adds later (trails, rider pins) land above it; the puck stays on top.
+            // Only on a position change, never per bearing sample: listing layers allocates.
+            style.moveStyleLayer(LAYER_ID, TOP)
+        }
+        map.triggerRepaint()
+    }
+
+    private inner class Host : CustomLayerHost {
+        private val vertices =
+            ByteBuffer.allocateDirect(VERTEX_COUNT * STRIDE).order(ByteOrder.nativeOrder()).asFloatBuffer()
+        private val projection = DoubleArray(16)
+        private val mvp = FloatArray(16)
+        private val saved = IntArray(8)
+        private val savedFlag = BooleanArray(1)
+        private var program = 0
+        private var mvpLocation = -1
+        private var metersPerPixelLocation = -1
+        private val vao = IntArray(1)
+        private val buffer = IntArray(1)
+        private var uploadedVersion = 0L
+        private var loggedError = false
+
+        // Render-thread copy of the shared state.
+        private var sLng = 0.0
+        private var sLat = 0.0
+        private var sBearing = Double.NaN
+        private var sArgb = 0
+        private var sShadowAlpha = 0f
+        private var sShown = false
+        private var sVersion = 0L
+
+        override fun initialize() {
+            val vs = compile(GLES30.GL_VERTEX_SHADER, VERTEX_SHADER)
+            val fs = compile(GLES30.GL_FRAGMENT_SHADER, FRAGMENT_SHADER)
+            if (vs == 0 || fs == 0) return
+            program = GLES30.glCreateProgram()
+            GLES30.glAttachShader(program, vs)
+            GLES30.glAttachShader(program, fs)
+            GLES30.glBindAttribLocation(program, 0, "a_pos")
+            GLES30.glBindAttribLocation(program, 1, "a_color")
+            GLES30.glLinkProgram(program)
+            GLES30.glDeleteShader(vs)
+            GLES30.glDeleteShader(fs)
+            GLES30.glGetProgramiv(program, GLES30.GL_LINK_STATUS, saved, 0)
+            if (saved[0] == 0) {
+                Log.e(TAG, "program link failed: ${GLES30.glGetProgramInfoLog(program)}")
+                GLES30.glDeleteProgram(program)
+                program = 0
+                return
+            }
+            mvpLocation = GLES30.glGetUniformLocation(program, "u_mvp")
+            metersPerPixelLocation = GLES30.glGetUniformLocation(program, "u_metersPerPixel")
+
+            GLES30.glGetIntegerv(GLES30.GL_VERTEX_ARRAY_BINDING, saved, 0)
+            GLES30.glGetIntegerv(GLES30.GL_ARRAY_BUFFER_BINDING, saved, 1)
+            GLES30.glGenVertexArrays(1, vao, 0)
+            GLES30.glGenBuffers(1, buffer, 0)
+            GLES30.glBindVertexArray(vao[0])
+            GLES30.glBindBuffer(GLES30.GL_ARRAY_BUFFER, buffer[0])
+            GLES30.glBufferData(GLES30.GL_ARRAY_BUFFER, VERTEX_COUNT * STRIDE, null, GLES30.GL_DYNAMIC_DRAW)
+            GLES30.glEnableVertexAttribArray(0)
+            GLES30.glVertexAttribPointer(0, 3, GLES30.GL_FLOAT, false, STRIDE, 0)
+            GLES30.glEnableVertexAttribArray(1)
+            GLES30.glVertexAttribPointer(1, 4, GLES30.GL_FLOAT, false, STRIDE, 3 * 4)
+            GLES30.glBindVertexArray(saved[0])
+            GLES30.glBindBuffer(GLES30.GL_ARRAY_BUFFER, saved[1])
+            uploadedVersion = 0
+        }
+
+        override fun render(parameters: CustomLayerRenderParameters) {
+            if (program == 0) return
+            synchronized(lock) {
+                sLng = lng
+                sLat = lat
+                sBearing = bearing
+                sArgb = argb
+                sShadowAlpha = shadowAlpha
+                sShown = shown
+                sVersion = geometryVersion
+            }
+            if (!sShown) return
+            val matrix = parameters.projectionMatrix
+            for (i in 0 until 16) projection[i] = matrix[i]
+
+            // Save what this draw touches.
+            GLES30.glGetIntegerv(GLES30.GL_CURRENT_PROGRAM, saved, 0)
+            GLES30.glGetIntegerv(GLES30.GL_VERTEX_ARRAY_BINDING, saved, 1)
+            GLES30.glGetIntegerv(GLES30.GL_ARRAY_BUFFER_BINDING, saved, 2)
+            GLES30.glGetIntegerv(GLES30.GL_BLEND_SRC_RGB, saved, 3)
+            GLES30.glGetIntegerv(GLES30.GL_BLEND_DST_RGB, saved, 4)
+            GLES30.glGetIntegerv(GLES30.GL_BLEND_SRC_ALPHA, saved, 5)
+            GLES30.glGetIntegerv(GLES30.GL_BLEND_DST_ALPHA, saved, 6)
+            GLES30.glGetBooleanv(GLES30.GL_DEPTH_WRITEMASK, savedFlag, 0)
+            val prevBlend = GLES30.glIsEnabled(GLES30.GL_BLEND)
+            val prevDepth = GLES30.glIsEnabled(GLES30.GL_DEPTH_TEST)
+            val prevStencil = GLES30.glIsEnabled(GLES30.GL_STENCIL_TEST)
+            val prevCull = GLES30.glIsEnabled(GLES30.GL_CULL_FACE)
+
+            GLES30.glBindVertexArray(vao[0])
+            GLES30.glBindBuffer(GLES30.GL_ARRAY_BUFFER, buffer[0])
+            if (uploadedVersion != sVersion) upload()
+
+            val worldSize = 512.0 * 2.0.pow(parameters.zoom)
+            val latRad = sLat.coerceIn(-MAX_LAT, MAX_LAT) * PI / 180.0
+            val x = (sLng + 180.0) / 360.0 * worldSize
+            val y = (1.0 - ln(tan(latRad) + 1.0 / cos(latRad)) / PI) / 2.0 * worldSize
+            val metersPerPixel = cos(parameters.latitude * PI / 180.0) * 2.0 * PI * EARTH_RADIUS / worldSize
+            // Screen-down on the ground: the map's bearing turns world north to screen up.
+            val mapBearing = parameters.bearing * PI / 180.0
+            val dropX = -sin(mapBearing) * SHADOW_DROP
+            val dropY = cos(mapBearing) * SHADOW_DROP
+
+            // Mapbox leaves its own errors in the queue; drop them so the check below sees only ours.
+            repeat(4) { GLES30.glGetError() }
+            GLES30.glUseProgram(program)
+            GLES30.glUniform1f(metersPerPixelLocation, metersPerPixel.toFloat())
+            GLES30.glDisable(GLES30.GL_DEPTH_TEST)
+            GLES30.glDisable(GLES30.GL_STENCIL_TEST)
+            GLES30.glDisable(GLES30.GL_CULL_FACE)
+            GLES30.glDepthMask(false)
+            GLES30.glEnable(GLES30.GL_BLEND)
+            GLES30.glBlendFunc(GLES30.GL_ONE, GLES30.GL_ONE_MINUS_SRC_ALPHA)
+
+            // Painter's order, valid from any heading and pitch: the camera is always above the
+            // coin, so the top face covers everything under it; the wall is one flat shade, so its
+            // back and front halves need no sorting; the arrow lies in the top plane.
+            draw(x + dropX, y + dropY, 0.0, SHADOW_FIRST, DISC_COUNT)
+            draw(x, y, 0.0, BODY_FIRST, BODY_COUNT)
+            if (!sBearing.isNaN()) draw(x, y, sBearing * PI / 180.0, ARROW_FIRST, ARROW_COUNT)
+            draw(x, y, 0.0, TOP_FIRST, TOP_COUNT)
+
+            val err = GLES30.glGetError()
+            if (err != GLES30.GL_NO_ERROR && !loggedError) {
+                Log.e(TAG, "GL error 0x${Integer.toHexString(err)} after draw")
+                loggedError = true
+            }
+
+            GLES30.glUseProgram(saved[0])
+            GLES30.glBindVertexArray(saved[1])
+            GLES30.glBindBuffer(GLES30.GL_ARRAY_BUFFER, saved[2])
+            GLES30.glBlendFuncSeparate(saved[3], saved[4], saved[5], saved[6])
+            GLES30.glDepthMask(savedFlag[0])
+            if (!prevBlend) GLES30.glDisable(GLES30.GL_BLEND)
+            if (prevDepth) GLES30.glEnable(GLES30.GL_DEPTH_TEST)
+            if (prevStencil) GLES30.glEnable(GLES30.GL_STENCIL_TEST)
+            if (prevCull) GLES30.glEnable(GLES30.GL_CULL_FACE)
+        }
+
+        override fun contextLost() {
+            // The GL objects died with the context; forget the handles, initialize runs again.
+            program = 0
+            vao[0] = 0
+            buffer[0] = 0
+            uploadedVersion = 0
+        }
+
+        override fun deinitialize() {
+            if (program != 0) GLES30.glDeleteProgram(program)
+            if (buffer[0] != 0) GLES30.glDeleteBuffers(1, buffer, 0)
+            if (vao[0] != 0) GLES30.glDeleteVertexArrays(1, vao, 0)
+            contextLost()
+        }
+
+        /** projection * translate(x, y) * rotateZ(angle), column-major; translation in doubles. */
+        private fun draw(x: Double, y: Double, angle: Double, first: Int, count: Int) {
+            val c = cos(angle)
+            val s = sin(angle)
+            val p = projection
+            for (r in 0 until 4) {
+                mvp[r] = (p[r] * c + p[4 + r] * s).toFloat()
+                mvp[4 + r] = (-p[r] * s + p[4 + r] * c).toFloat()
+                mvp[8 + r] = p[8 + r].toFloat()
+                mvp[12 + r] = (p[r] * x + p[4 + r] * y + p[12 + r]).toFloat()
+            }
+            GLES30.glUniformMatrix4fv(mvpLocation, 1, false, mvp, 0)
+            GLES30.glDrawArrays(GLES30.GL_TRIANGLES, first, count)
+        }
+
+        /** Rebuilds the vertex data; only when colour or shadow change. */
+        private fun upload() {
+            val a = ((sArgb ushr 24) and 0xFF) / 255f
+            val r = ((sArgb ushr 16) and 0xFF) / 255f
+            val g = ((sArgb ushr 8) and 0xFF) / 255f
+            val b = (sArgb and 0xFF) / 255f
+            val v = vertices
+            v.clear()
+            disc(v, SHADOW_RADIUS, 0f, 0f, 0f, 0f, sShadowAlpha)
+            disc(v, COIN_RADIUS, 0f, r * WALL_SHADE, g * WALL_SHADE, b * WALL_SHADE, a)
+            wall(v, r * WALL_SHADE, g * WALL_SHADE, b * WALL_SHADE, a)
+            // Pointing north (world y is south); the draw rotates it clockwise by the bearing.
+            vertex(v, 0f, -ARROW_TIP, COIN_HEIGHT, 1f, 1f, 1f, 1f)
+            vertex(v, ARROW_HALF_WIDTH, -ARROW_BASE, COIN_HEIGHT, 1f, 1f, 1f, 1f)
+            vertex(v, -ARROW_HALF_WIDTH, -ARROW_BASE, COIN_HEIGHT, 1f, 1f, 1f, 1f)
+            disc(v, COIN_RADIUS, COIN_HEIGHT, 1f, 1f, 1f, 1f)
+            disc(v, COIN_RADIUS - RIM_WIDTH, COIN_HEIGHT, r, g, b, a)
+            v.flip()
+            GLES30.glBufferSubData(GLES30.GL_ARRAY_BUFFER, 0, v.limit() * 4, v)
+            uploadedVersion = sVersion
+        }
+    }
+
+    companion object {
+        private const val TAG = "RNMBXPuck"
+        private const val LAYER_ID = "rnmbx-puck"
+        private val TOP = LayerPosition(null, null, null)
+
+        // GpsPuck's coin, in dp.
+        private const val COIN_RADIUS = 11f
+        private const val COIN_HEIGHT = 12f
+        private const val RIM_WIDTH = 3f
+        private const val SHADOW_RADIUS = 15f
+        /** Towards the bottom of the screen. */
+        private const val SHADOW_DROP = 2.0
+        /** 40% black over the rider colour. */
+        private const val WALL_SHADE = 0.6f
+        private const val ARROW_HALF_WIDTH = 9f
+        private const val ARROW_LENGTH = 14f
+        private const val ARROW_TUCK = 4f
+        private const val ARROW_BASE = COIN_RADIUS - ARROW_TUCK
+        private const val ARROW_TIP = ARROW_BASE + ARROW_LENGTH
+        private const val SEGMENTS = 48
+        private const val EARTH_RADIUS = 6378137.0
+        private const val MAX_LAT = 85.051128
+
+        // Buffer layout, in draw order.
+        private const val STRIDE = 7 * 4
+        private const val DISC_COUNT = 3 * SEGMENTS
+        private const val SHADOW_FIRST = 0
+        private const val BODY_FIRST = SHADOW_FIRST + DISC_COUNT // base disc + side wall
+        private const val BODY_COUNT = DISC_COUNT + 6 * SEGMENTS
+        private const val ARROW_FIRST = BODY_FIRST + BODY_COUNT
+        private const val ARROW_COUNT = 3
+        private const val TOP_FIRST = ARROW_FIRST + ARROW_COUNT // white rim disc + colour disc
+        private const val TOP_COUNT = 2 * DISC_COUNT
+        private const val VERTEX_COUNT = TOP_FIRST + TOP_COUNT
+
+        private const val VERTEX_SHADER = """#version 300 es
+uniform mat4 u_mvp;
+uniform float u_metersPerPixel;
+in vec3 a_pos;
+in vec4 a_color;
