  "otherSessionId": "1a2b3c4d-0000-4000-8000-000000000000",
  "helloRequestId": 1,
  "timing": {
    "leaseMs": 2000,
    "renewIntervalMs": 500,
    "requestTimeoutMs": 500,
    "handshakeTimeoutMs": 3000
  },
